---
import navigation from "../data/navigation.json";
import { withBase } from "../utils/withBase";

const { currentPath = "/" } = Astro.props;
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith("/") ? base.slice(0, -1) : base;
const pathWithoutBase =
  normalizedBase && currentPath.startsWith(normalizedBase)
    ? currentPath.slice(normalizedBase.length) || "/"
    : currentPath;
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href={withBase("/")}>
      <img src="/seed-logo.png" alt="The SEED Lab" class="brand-logo" />
      <div class="brand-words">
        <span class="brand-mark">The SEED Lab</span>
        <span class="brand-sub">Supporting Educators in Effective Development</span>
      </div>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {navigation.filter(item => item.href !== "/say-hello").map((item) => {
          const isActive =
            item.href === "/"
              ? pathWithoutBase === "/"
              : pathWithoutBase.startsWith(item.href);

          return (
            <li>
              <a class:list={["nav-link", { active: isActive }]} href={withBase(item.href)}>
                {item.label}
              </a>
            </li>
          );
        })}
        <li>
          <a class="nav-cta" href={withBase("/say-hello")}>Say Hello</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .brand-logo {
    height: 3rem;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .brand-words {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: -0.2rem;
  }

  .brand-sub {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.03em;
    line-height: 1;
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/withBase";
---

<BaseLayout
  title="About"
  description="Lee Mayes is a primary PE, movement and wellbeing educator in Nanjing, China — and the person behind The SEED Lab."
>

  <section class="about-hero">
    <div class="shell about-hero-inner">
      <div class="about-hero-text stack">
        <span class="eyebrow cosmic">About The SEED Lab</span>
        <h1 class="about-hero-title">A small educational greenhouse.</h1>
        <p class="about-hero-lead">
          Some ideas are fully grown, some are still sprouting, and some are here simply
          because they might help someone else start something useful.
        </p>
        <p class="about-hero-question">
          How do we help young people feel safe, connected, capable, and ready to grow?
        </p>
      </div>
      <div class="about-hero-logo" aria-hidden="true">
        <img src="/seed-lab-logo.png" alt="" class="about-logo-img" />
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell about-bio">
      <div class="about-photo-col">
        <img src="/lee-and-gatis.jpg" alt="Lee and Gatis" class="about-photo" loading="lazy" />
        <p class="about-photo-caption">Lee (right) with Gatis, the teacher whose clinical practice journey sparked The SEED Lab.</p>
      </div>
      <div class="stack">
        <span class="eyebrow">The person behind SEED</span>
        <h2>Hi, I'm Lee.</h2>
        <p>
          I'm a primary PE, movement, and wellbeing educator living and teaching in Nanjing, China.
          I created The SEED Lab as a home for the ideas, resources, reflections, and classroom
          experiments that grow out of my work with children, teachers, and school communities.
        </p>
        <p>
          For me, PE is about much more than sport. It is a space where children learn how to move,
          cooperate, solve problems, manage challenge, understand their bodies, and discover what kind
          of teammate, learner, and person they are becoming.
        </p>
        <p>
          My work sits somewhere between movement, wellbeing, relationships, and identity. I'm
          interested in how children build confidence, how groups learn to work together, how routines
          create safety, and how physical activity can help young people better understand themselves
          and others.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-column">
      <div class="quote-card stack">
        <span class="eyebrow">How it started</span>
        <h2>A seed planted through mentoring.</h2>
        <p>
          The seed for this project was planted through my work mentoring another teacher, Gatis,
          during his clinical practice journey. What began as lesson feedback, reflective conversations,
          rubric-aligned observations, and practical teaching support slowly grew into something bigger:
          a collection of tools and ideas that could help make good teaching more visible, thoughtful,
          and shareable.
        </p>
      </div>
      <div class="panel stack">
        <span class="eyebrow">What you'll find here</span>
        <h3>A growing collection</h3>
        <ul class="list-clean">
          <li>Practical teaching tools and prompt cards</li>
          <li>Curriculum thinking and planning examples</li>
          <li>Wellbeing resources and visual supports</li>
          <li>Teacher-built apps for PE and movement</li>
          <li>Honest reflections from inside the classroom</li>
          <li>Mentoring notes and professional growth tools</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="about-audience">
        <div class="panel stack">
          <span class="eyebrow">Who this is for</span>
          <h3>Teachers first</h3>
          <p>Primary teachers, PE educators, IB practitioners, new teachers finding their feet, and experienced teachers looking for fresh practical ideas.</p>
        </div>
        <div class="panel stack">
          <span class="eyebrow">The approach</span>
          <h3>Practical, not theoretical</h3>
          <p>Every resource here has been tested in a real classroom. Nothing is added because it looks good on paper — only because it actually works with real children.</p>
        </div>
        <div class="panel stack">
          <span class="eyebrow">The future</span>
          <h3>Always growing</h3>
          <p>The SEED Lab is designed to expand thoughtfully — for parents, students, and wider school communities when the time is right.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-column">
      <div class="quote-card stack">
        <span class="eyebrow">Get in touch</span>
        <h2>Have an idea, a request, or just want to say hello?</h2>
        <p>
          The SEED Lab grows through genuine teacher needs. Every message is read personally.
        </p>
        <a class="button" href={withBase("/say-hello")} style="width: fit-content; margin-top: 0.5rem;">Say hello →</a>
      </div>
      <div class="panel stack">
        <span class="eyebrow">Start exploring</span>
        <h3>The resources are the best starting point</h3>
        <p>Downloadable tools, prompt cards, infographics, and interactive apps — all free, no sign-up required.</p>
        <a class="button-secondary" href={withBase("/resources")} style="width: fit-content; margin-top: 0.5rem;">Browse resources →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── About hero ── */
  .about-hero {
    background:
      radial-gradient(ellipse 55% 50% at 85% 20%, rgba(90,40,130,0.25) 0%, transparent 65%),
      radial-gradient(ellipse 40% 35% at 15% 75%, rgba(20,100,130,0.20) 0%, transparent 60%),
      radial-gradient(ellipse 80% 65% at 50% 0%, #1a2f55 0%, var(--deep-navy) 55%, var(--space-black) 100%);
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--line-cosmic);
  }

  .about-hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
  }

  .about-hero-title {
    font-family: "Fraunces", serif;
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    color: var(--starlight);
    line-height: 1.08;
    margin: 0.5rem 0 0;
    letter-spacing: -0.02em;
  }

  .about-hero-lead {
    font-size: 1.05rem;
    color: rgba(243,232,208,0.75);
    max-width: 52ch;
    line-height: 1.75;
    margin: 0;
  }

  .about-hero-question {
    font-family: "Fraunces", serif;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--growth-green);
    max-width: 48ch;
    line-height: 1.55;
    margin: 0;
  }

  .about-hero-logo {
    flex-shrink: 0;
  }

  .about-logo-img {
    width: clamp(180px, 20vw, 280px);
    height: auto;
    display: block;
    mix-blend-mode: screen;
    opacity: 0.82;
    filter: drop-shadow(0 0 30px rgba(127,176,105,0.25));
  }

  @media (max-width: 860px) {
    .about-hero-inner {
      grid-template-columns: 1fr;
    }
    .about-hero-logo {
      display: none;
    }
  }

  /* ── Bio section ── */
  .about-bio {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .about-photo-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-photo {
    width: 100%;
    border-radius: var(--radius);
    object-fit: cover;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }

  .about-photo-caption {
    font-size: 0.82rem;
    color: var(--muted);
    font-style: italic;
    line-height: 1.5;
    max-width: none;
  }

  .about-audience {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .about-bio,
    .about-audience {
      grid-template-columns: 1fr;
    }
  }
</style>

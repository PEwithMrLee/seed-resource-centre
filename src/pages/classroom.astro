---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/withBase";
---

<BaseLayout
  title="Inside My Classroom"
  description="A window into real teaching practice — curriculum design, learning routines, assessment, and day-to-day life in the classroom."
>
  <!-- ── Cosmic hero ── -->
  <section class="classroom-hero">
    <div class="shell">
      <div class="ch-inner">
        <span class="eyebrow cosmic">Inside My Classroom</span>
        <h1 class="ch-title">Systems, routines, and learning in motion.</h1>
        <p class="ch-lead">
          Step inside the classroom structures, routines, visuals, and learning systems that
          shape my PE and wellbeing practice. This is the real practice behind the resources.
        </p>
        <p class="ch-sub">
          Real teaching. Real examples. For lessons that wobble before they bloom.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Teaching philosophy ── -->
  <section class="section ch-philosophy">
    <div class="shell">
      <div class="phil-grid">
        <div class="phil-copy stack">
          <span class="eyebrow">Teaching philosophy</span>
          <h2>PE as a place to become, not just to perform.</h2>
          <p>
            This section answers the question teachers ask most:
            <em>but what does it actually look like?</em>
          </p>
          <p>
            My teaching is built around the belief that physical education is one of the most
            powerful spaces in a school. It's where children learn how to cooperate under pressure,
            manage their emotions in public, take risks in front of peers, and discover something real
            about who they are becoming.
          </p>
          <p>
            Everything on this page — the routines, the tech tools, the planning structures — comes
            back to the same question: how do we help every child feel safe enough to try?
          </p>
        </div>

        <!-- Constellation map of principles -->
        <div class="constellation-map" aria-label="Core teaching principles">
          <div class="const-title">Core principles</div>
          <svg class="const-lines" viewBox="0 0 300 280" aria-hidden="true">
            <g stroke="rgba(125,211,252,0.15)" stroke-width="1" fill="none">
              <line x1="150" y1="140" x2="80"  y2="60"/>
              <line x1="150" y1="140" x2="220" y2="60"/>
              <line x1="150" y1="140" x2="60"  y2="180"/>
              <line x1="150" y1="140" x2="240" y2="180"/>
              <line x1="150" y1="140" x2="150" y2="240"/>
              <line x1="80"  y1="60"  x2="220" y2="60"/>
              <line x1="60"  y1="180" x2="240" y2="180"/>
            </g>
            <g fill="rgba(127,176,105,0.5)">
              <circle cx="150" cy="140" r="3"/>
              <circle cx="80"  cy="60"  r="2"/>
              <circle cx="220" cy="60"  r="2"/>
              <circle cx="60"  cy="180" r="2"/>
              <circle cx="240" cy="180" r="2"/>
              <circle cx="150" cy="240" r="2"/>
            </g>
          </svg>
          <div class="const-nodes">
            <div class="const-node const-node--centre">
              <span class="node-label">Movement<br/>& Learning</span>
            </div>
            <div class="const-node const-node--tl">
              <span class="node-icon">🛡️</span>
              <span class="node-label">Psychological<br/>Safety</span>
            </div>
            <div class="const-node const-node--tr">
              <span class="node-icon">🤝</span>
              <span class="node-label">Belonging<br/>& Connection</span>
            </div>
            <div class="const-node const-node--ml">
              <span class="node-icon">💪</span>
              <span class="node-label">Challenge<br/>& Capability</span>
            </div>
            <div class="const-node const-node--mr">
              <span class="node-icon">🔍</span>
              <span class="node-label">Reflection<br/>& Growth</span>
            </div>
            <div class="const-node const-node--b">
              <span class="node-icon">🌱</span>
              <span class="node-label">Identity<br/>& Becoming</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Curriculum Design & Alignment</span>
          <h2>Building a curriculum that connects vertically and horizontally.</h2>
        </div>
      </div>
      <div class="classroom-grid">
        <div class="panel stack">
          <h3>Vertical Progression</h3>
          <p>How skills and concepts build deliberately across year levels — so students aren't starting from scratch each year.</p>
          <a class="card-cta" href={withBase("/resources#vertical-horizontal-alignment")}>See the alignment infographic →</a>
        </div>
        <div class="panel stack">
          <h3>Horizontal Alignment</h3>
          <p>How units across subjects connect at the same year level — building coherence without losing subject identity.</p>
          <a class="card-cta" href={withBase("/resources#vertical-horizontal-alignment")}>See the alignment infographic →</a>
        </div>
        <div class="panel stack">
          <h3>IB Curriculum Mapping</h3>
          <p>Practical examples of mapping IB frameworks to real units — keeping the documentation useful rather than decorative.</p>
          <a class="card-cta" href={withBase("/resources")}>Browse planning resources →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Making Learning Visible</span>
          <h2>When students can see their learning, they take ownership of it.</h2>
        </div>
      </div>
      <div class="classroom-grid">
        <div class="panel stack">
          <h3>Assessment in Practice</h3>
          <p>Assessment that informs teaching — not just grades. Examples of how formative and summative tasks work together.</p>
        </div>
        <div class="panel stack">
          <h3>Student Reflection</h3>
          <p>Simple, consistent reflection routines that help students understand what they've learned and where to go next.</p>
        </div>
        <div class="panel stack">
          <h3>Feedback That Works</h3>
          <p>Practical feedback strategies that students actually use — specific, timely, and connected to next steps.</p>
          <a class="card-cta" href={withBase("/resources#making-learning-visible")}>See the infographic →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Daily Routines & Structures</span>
          <h2>The systems that make a classroom run smoothly.</h2>
        </div>
      </div>
      <div class="classroom-grid">
        <div class="panel stack">
          <h3>Lesson Openings</h3>
          <p>How a lesson starts shapes everything that follows. Intentional openings that settle students and signal what's coming.</p>
          <a class="card-cta" href={withBase("/resources#how-you-start-shapes-everything")}>See the G.R.E.E.T prompt card →</a>
        </div>
        <div class="panel stack">
          <h3>Reducing Teacher Talk</h3>
          <p>The L.E.S.S framework in practice — how to give clearer instructions, ask better questions, and create more thinking time.</p>
          <a class="card-cta" href={withBase("/resources#say-less-get-more")}>See the L.E.S.S prompt card →</a>
        </div>
        <div class="panel stack">
          <h3>Transitions & Flow</h3>
          <p>Smooth transitions that don't lose momentum — practical signals, routines, and structures that keep class flow consistent.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">

      <!-- ROW 1: Text left + iPad right (Option A style) -->
      <div class="tech-top">
        <div class="tech-text stack">
          <span class="eyebrow">Tech Integration in PE</span>
          <h2>A PE challenge app students actually want to use.</h2>
          <p>Built for the gym. Runs on any iPad or laptop. No login, no setup — just open and go. Four challenge categories, progressive difficulty levels, video demos, and built-in score logging.</p>
          <ul class="tech-feature-list">
            <li>Easy → Medium → Hard progression per challenge</li>
            <li>Video demo filmed in a real gym for every challenge</li>
            <li>Score logging + reflection built in</li>
            <li>No app download — works in any browser</li>
          </ul>
          <div class="tech-intro-actions">
            <a class="button" href="/pe-challenges.html" target="_blank">Open the app →</a>
            <a class="button-secondary" href={withBase("/say-hello")}>Request a demo</a>
          </div>
        </div>
        <div class="tech-ipad">
          <div class="ipad-landscape">
            <div class="ipad-left-bar"><div class="ipad-camera-side"></div></div>
            <div class="ipad-screen-landscape">
              <div class="app-mockup">
                <div class="app-header"><span class="app-trophy">🏆</span><span class="app-title">PE Challenges</span></div>
                <p class="app-subtitle">Choose a category to get started</p>
                <div class="app-categories">
                  <div class="app-cat orange"><span class="app-cat-icon">🏀</span><strong>Sport Skills</strong><span>Measurable sport challenges</span></div>
                  <div class="app-cat blue"><span class="app-cat-icon">💪</span><strong>Fitness Challenges</strong><span>Strength &amp; endurance tests</span></div>
                  <div class="app-cat green"><span class="app-cat-icon">🎯</span><strong>Target Games</strong><span>Accuracy &amp; focus tasks</span></div>
                  <div class="app-cat purple"><span class="app-cat-icon">🤸</span><strong>Movement Circuits</strong><span>Station-based activities</span></div>
                </div>
              </div>
            </div>
            <div class="ipad-right-bar"><div class="ipad-home-side"></div></div>
          </div>
        </div>
      </div>

      <!-- ROW 2: 3 feature cards (Option B style) -->
      <div class="tech-features">
        <div class="tech-feat-card green-top">
          <span class="tech-feat-icon">🎯</span>
          <h4>Progressive Difficulty</h4>
          <p>Easy, Medium and Hard challenges unlock in sequence — students stay motivated and challenged at their own level.</p>
        </div>
        <div class="tech-feat-card orange-top">
          <span class="tech-feat-icon">📹</span>
          <h4>Video Demonstrations</h4>
          <p>Every challenge includes a real classroom video demo so students know exactly what to do before they start.</p>
        </div>
        <div class="tech-feat-card purple-top">
          <span class="tech-feat-icon">📝</span>
          <h4>Score & Reflect</h4>
          <p>Students log their score, rate their effort, and write a short reflection — building self-assessment habits every lesson.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- PE Circle -->
  <section class="section">
    <div class="shell">
      <div class="circle-section">

        <div class="circle-text stack">
          <div class="circle-badges">
            <span class="badge-private">🔒 Teacher Only</span>
            <span class="badge-tool">AI-Assisted Teacher Tool</span>
          </div>
          <span class="eyebrow">PE Circle</span>
          <h2>What if the tools we use actually helped us be more present with students?</h2>
          <p>
            PE Circle is a teacher-facing app for opening and closing PE lessons with intention.
            It tracks student readiness, wellbeing, and ATL skills in real time — and closes every
            lesson with structured reflection, IB-aligned prompts, and a celebration moment.
          </p>
          <ul class="tech-feature-list">
            <li>At-a-glance student readiness — who needs a check-in before class starts</li>
            <li>Closing reflection linked to ATL skills and the IB Learner Profile</li>
            <li>Structured sharing protocol and closing energiser built in</li>
            <li>Works across all 13 classes — syncs history to Google Sheets</li>
            <li>Password protected — completely private, built for your context</li>
          </ul>
          <p class="circle-quote">
            "Built specifically for my school, my students, and my IB framework —
            not an off-the-shelf product."
          </p>
          <div class="tech-intro-actions">
            <a class="button" href="/circle-app.html" target="_blank">Open the app →</a>
            <a class="button-secondary" href={withBase("/say-hello")}>Request a demo</a>
          </div>
        </div>

        <div class="circle-visual">
          <div class="circle-ipad">
            <div class="ipad-landscape">
              <div class="ipad-left-bar"><div class="ipad-camera-side"></div></div>
              <div class="ipad-screen-landscape">
                <div class="circle-mockup">
                  <div class="circle-app-header">
                    <span class="circle-app-icon">⭕</span>
                    <span class="circle-app-title">PE Circle</span>
                    <span class="circle-app-class">G4B — Morning</span>
                  </div>
                  <div class="circle-app-body">
                    <div class="circle-phase">
                      <p class="circle-phase-label">OPENING CHECK-IN</p>
                      <div class="circle-students">
                        <div class="cs green">😊<span>Ready</span></div>
                        <div class="cs green">😊<span>Ready</span></div>
                        <div class="cs amber">😐<span>Check in</span></div>
                        <div class="cs green">😊<span>Ready</span></div>
                        <div class="cs red">😔<span>Support</span></div>
                        <div class="cs green">😊<span>Ready</span></div>
                      </div>
                    </div>
                    <div class="circle-divider"></div>
                    <div class="circle-phase">
                      <p class="circle-phase-label">CLOSING REFLECTION</p>
                      <div class="circle-atl">
                        <div class="atl-tag">Self-Management</div>
                        <div class="atl-tag">Communication</div>
                        <div class="atl-tag">Reflective 🌱</div>
                      </div>
                      <div class="circle-prompt">"What did you adjust during the lesson to improve?"</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="ipad-right-bar"><div class="ipad-home-side"></div></div>
            </div>
          </div>
          <p class="circle-caption">Password protected — teacher access only</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Class Compass -->
  <section class="section section-soft">
    <div class="shell">
      <div class="tech-top">
        <div class="tech-text stack">
          <div class="circle-badges">
            <span class="badge-tool">Student-Facing</span>
            <span class="badge-tool">Wellbeing & SEL</span>
            <span class="badge-tool">AI-Assisted Teacher Tool</span>
          </div>
          <span class="eyebrow">Class Compass</span>
          <h2>Shift from "how do I stop this?" to "what is this child showing me?"</h2>
          <p>
            Class Compass is a practical, gamified behaviour support tool for primary teachers and parents.
            Grounded in evidence from Ross Greene, Daniel Siegel, Stuart Shanker, and Mona Delahooke —
            it uses a regulation-informed, relationship-centred lens to help adults understand and respond
            to behaviour with curiosity rather than control.
          </p>
          <ul class="tech-feature-list">
            <li>Quick Help — in-the-moment support for challenging situations</li>
            <li>18 research-informed strategies with quizzes and real-world missions</li>
            <li>30-module learning course across 6 worlds</li>
            <li>Behaviour Translator — reframes what you see into what a child may need</li>
            <li>Phrase Bank — 47 ready-to-use scripts for tricky moments</li>
            <li>Reflection Log — notice patterns in behaviour over time</li>
          </ul>
          <div class="tech-intro-actions">
            <a class="button" href="/class-compass/" target="_blank">Open Class Compass →</a>
            <a class="button-secondary" href={withBase("/say-hello")}>Request a demo</a>
          </div>
        </div>
        <div class="tech-ipad">
          <div class="ipad-landscape">
            <div class="ipad-left-bar"><div class="ipad-camera-side"></div></div>
            <div class="ipad-screen-landscape">
              <div class="compass-mockup">
                <div class="compass-header">
                  <span class="compass-icon">🧭</span>
                  <span class="compass-title">Class Compass</span>
                </div>
                <div class="compass-body">
                  <p class="compass-tagline">What do you need right now?</p>
                  <div class="compass-grid">
                    <div class="compass-card red-card"><span>🆘</span><strong>Help Now</strong><small>In-moment support</small></div>
                    <div class="compass-card green-card"><span>🌱</span><strong>Learn</strong><small>Strategy library</small></div>
                    <div class="compass-card blue-card"><span>🎯</span><strong>Try a Mission</strong><small>This week's quest</small></div>
                    <div class="compass-card purple-card"><span>🔍</span><strong>Reflect</strong><small>Log what happened</small></div>
                    <div class="compass-card yellow-card"><span>🧰</span><strong>My Toolkit</strong><small>Saved strategies</small></div>
                    <div class="compass-card orange-card"><span>⭐</span><strong>Progress</strong><small>Badges & XP</small></div>
                  </div>
                  <div class="compass-xp">
                    <span class="compass-level">Level 2: Noticer → Calm Builder</span>
                    <span class="compass-pts">140 XP ⭐</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="ipad-right-bar"><div class="ipad-home-side"></div></div>
          </div>
        </div>
      </div>

      <div class="tech-features">
        <div class="tech-feat-card green-top">
          <span class="tech-feat-icon">🧠</span>
          <h4>Behaviour as Information</h4>
          <p>The Behaviour Translator reframes what you're seeing into what a child may need — shifting from "how do I stop this?" to "what skill is missing here?"</p>
        </div>
        <div class="tech-feat-card orange-top">
          <span class="tech-feat-icon">📚</span>
          <h4>Research-Informed Strategies</h4>
          <p>18 strategies with quizzes and real-world missions, a 47-script Phrase Bank, and a 30-module course — all grounded in Greene, Siegel, Shanker, and Delahooke.</p>
        </div>
        <div class="tech-feat-card purple-top">
          <span class="tech-feat-icon">🎮</span>
          <h4>Warm & ADHD-Friendly</h4>
          <p>Gamified with XP and badges, designed around small achievable moves, and built to feel warm and colourful — so adults actually come back to it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Quest -->
  <section class="section section-soft">
    <div class="shell">
      <div class="tech-top">
        <div class="tech-text stack">
          <div class="circle-badges">
            <span class="badge-tool">Student & Teacher</span>
            <span class="badge-tool">IB / ATL Aligned</span>
            <span class="badge-tool">AI-Assisted Teacher Tool</span>
          </div>
          <span class="eyebrow">Team Quest</span>
          <h2>Building team culture — one challenge at a time.</h2>
          <p>
            Team Quest is a team-based progression app where groups of 3–5 students level up
            together across a PE unit — completing physical and collaboration challenges, setting
            weekly goals, and reflecting on their growth as a team.
          </p>
          <ul class="tech-feature-list">
            <li>5 levels: 🌱 Seed → 🌿 Sprout → 🌳 Growth → 🌸 Bloom → 🌻 Thrive</li>
            <li>Physical challenges + ATL collaboration challenges</li>
            <li>Grade-differentiated language — G1 through G5</li>
            <li>Weekly goals, check-ins, and structured reflections</li>
            <li>Teacher dashboard — approve challenges, award badges, track ATL skills</li>
            <li>Syncs to Google Sheets — full unit data saved automatically</li>
          </ul>
          <div class="tech-intro-actions">
            <a class="button" href="/team-quest.html" target="_blank">Open Team Quest →</a>
            <a class="button-secondary" href={withBase("/say-hello")}>Request a demo</a>
          </div>
        </div>
        <div class="tech-ipad">
          <div class="ipad-landscape">
            <div class="ipad-left-bar"><div class="ipad-camera-side"></div></div>
            <div class="ipad-screen-landscape">
              <div class="tq-mockup">
                <div class="tq-header">
                  <span class="tq-icon">🏆</span>
                  <span class="tq-title">Team Quest</span>
                  <span class="tq-unit">Basketball Unit 2 · G4</span>
                </div>
                <div class="tq-body">
                  <div class="tq-team falcons">
                    <div class="tq-team-info">
                      <span class="tq-team-name">🦅 The Falcons</span>
                      <span class="tq-level">🌳 Growth</span>
                    </div>
                    <div class="tq-bar"><div class="tq-fill" style="width:72%"></div></div>
                  </div>
                  <div class="tq-team storm">
                    <div class="tq-team-info">
                      <span class="tq-team-name">⚡ Storm Squad</span>
                      <span class="tq-level">🌿 Sprout</span>
                    </div>
                    <div class="tq-bar"><div class="tq-fill" style="width:45%"></div></div>
                  </div>
                  <div class="tq-team rise">
                    <div class="tq-team-info">
                      <span class="tq-team-name">🌊 The Rise</span>
                      <span class="tq-level">🌸 Bloom</span>
                    </div>
                    <div class="tq-bar"><div class="tq-fill" style="width:88%"></div></div>
                  </div>
                  <div class="tq-pending">
                    <span class="tq-pending-label">⏳ 3 challenges awaiting approval</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="ipad-right-bar"><div class="ipad-home-side"></div></div>
          </div>
        </div>
      </div>

      <!-- 3 feature cards -->
      <div class="tech-features">
        <div class="tech-feat-card green-top">
          <span class="tech-feat-icon">🌱</span>
          <h4>Level Progression</h4>
          <p>Teams advance through 5 SEED-branded levels by completing a mix of physical and collaboration challenges — unlocked only after teacher approval.</p>
        </div>
        <div class="tech-feat-card orange-top">
          <span class="tech-feat-icon">🤝</span>
          <h4>ATL & Learner Profile</h4>
          <p>Every collaboration challenge is mapped to IB ATL skills and Learner Profile attributes. Language and complexity automatically adjust for G1–G5.</p>
        </div>
        <div class="tech-feat-card purple-top">
          <span class="tech-feat-icon">📊</span>
          <h4>Teacher Dashboard</h4>
          <p>Approve challenges, award special badges, open weekly goal windows, and track which ATL skills each team has demonstrated — all from your own device.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-column">
      <div class="quote-card stack">
        <span class="eyebrow">More coming soon</span>
        <h2>Unit design, events, and real lesson examples on the way.</h2>
        <p>
          This section grows alongside the resource library. Upcoming additions include full unit planning examples,
          Athletics Day organisation, and real lesson walkthroughs with reflections.
        </p>
      </div>
      <div class="panel stack">
        <span class="eyebrow">In the meantime</span>
        <h3>Start with the resources</h3>
        <p>The downloadable resources are the most practical starting point — prompt cards, infographics, and planning tools ready to use today.</p>
        <a class="button" href={withBase("/resources")} style="width: fit-content; margin-top: 0.5rem;">Browse resources</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Cosmic hero ── */
  .classroom-hero {
    background:
      radial-gradient(ellipse 55% 50% at 85% 20%, rgba(90,40,130,0.25) 0%, transparent 65%),
      radial-gradient(ellipse 40% 35% at 15% 75%, rgba(20,100,130,0.20) 0%, transparent 60%),
      radial-gradient(ellipse 80% 60% at 50% 0%, #1a2f55 0%, var(--deep-navy) 55%, var(--space-black) 100%);
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--line-cosmic);
  }
  .ch-inner { max-width: 640px; }
  .ch-title {
    font-family: "Fraunces", serif;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    color: var(--starlight);
    line-height: 1.08;
    margin: 0.5rem 0 0;
    letter-spacing: -0.02em;
  }
  .ch-lead {
    font-size: 1.1rem;
    color: rgba(243,232,208,0.8);
    max-width: 54ch;
    margin-top: 1.25rem;
    line-height: 1.75;
  }
  .ch-sub {
    font-family: "Fraunces", serif;
    font-style: italic;
    font-size: 0.98rem;
    color: var(--growth-green);
    margin-top: 0.75rem;
    max-width: none;
  }

  /* ── Philosophy ── */
  .ch-philosophy {
    background:
      radial-gradient(ellipse 55% 35% at 90% 10%, rgba(200,158,60,0.07) 0%, transparent 65%),

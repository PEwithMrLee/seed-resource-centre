---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResourceCard from "../components/ResourceCard.astro";
import resources from "../data/resources.json";
import site from "../data/site.json";
import { withBase } from "../utils/withBase";

const featuredResources = resources.filter((resource) => resource.featured).slice(0, 3);
---

<BaseLayout title="Home" description={site.description}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy stack">
        <span class="eyebrow">Supporting Educators in Effective Development</span>
        <h1>SEED is a growing resource centre for teachers, rooted in calm and practical support.</h1>
        <p>
          SEED stands for <strong>Supporting Educators in Effective Development</strong>. It is a
          warm, professional space for teachers now, designed to expand thoughtfully for parents
          and students over time.
        </p>
        <p class="accent-note">
          The aim is simple: offer useful resources with clarity, warmth, and enough room to grow
          without becoming busy or hard to maintain.
        </p>
        <div class="hero-actions">
          <a class="button" href={withBase("/resources")}>Browse resources</a>
          <a class="button-secondary" href={withBase("/about")}>About SEED</a>
        </div>
      </div>

      <aside class="panel hero-panel stack">
        <span class="brand-chip">A calm space that can keep growing</span>
        <h2>Built to support teachers today, with a natural path for future audiences.</h2>
        <p>
          Structured content keeps the site manageable, while the design language gives SEED a more
          living, grounded identity shaped by growth, care, and steady development.
        </p>
        <div class="hero-support">
          <div class="micro-grid">
            <div class="micro-card">
              <strong>Rooted</strong>
              <p>Teacher-first resources with clarity and purpose.</p>
            </div>
            <div class="micro-card">
              <strong>Growing</strong>
              <p>Ready to expand gently for parents and students later.</p>
            </div>
            <div class="micro-card">
              <strong>Steady</strong>
              <p>Simple to edit, fast to load, and easy to maintain.</p>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Featured Resources</span>
          <h2>Useful starting points for the first version of SEED.</h2>
        </div>
        <a class="button-secondary" href={withBase("/resources")}>See all resources</a>
      </div>

      <div class="resources-grid">
        {featuredResources.map((resource) => <ResourceCard {...resource} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell two-column">
      <div class="quote-card stack">
        <span class="eyebrow">Designed for real use</span>
        <h2>Professional enough to trust, welcoming enough to return to.</h2>
        <p>
          SEED is intended to feel like a growing collection rather than a crowded portal: clear,
          thoughtful, and quietly energising for busy educators.
        </p>
      </div>
      <div class="panel split-callout stack">
        <span class="eyebrow">Brand direction</span>
        <h3>A resource centre that grows with its community</h3>
        <ul class="list-clean">
          <li>Built for teachers first, with future space for parents and students</li>
          <li>Organic tones and gentle contrast to reflect growth without distraction</li>
          <li>Simple content structures that keep expansion manageable over time</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

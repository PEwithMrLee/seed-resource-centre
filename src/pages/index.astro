---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResourceCard from "../components/ResourceCard.astro";
import resources from "../data/resources.json";
import site from "../data/site.json";
import { withBase } from "../utils/withBase";

const featuredResources = resources.filter((resource) => resource.featured).slice(0, 3);
---

<BaseLayout title="Home" description={site.description}>

  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy stack">
        <span class="eyebrow">For teachers, by a teacher</span>
        <h1>Practical ideas and tools for busy educators.</h1>
        <p>
          The SEED Lab is a growing resource centre built around real classroom practice —
          downloadable tools, curriculum design examples, and teaching strategies you can use straight away.
        </p>
        <div class="hero-actions">
          <a class="button" href={withBase("/resources")}>Browse resources</a>
          <a class="button-secondary" href={withBase("/classroom")}>Inside my classroom</a>
        </div>
      </div>

      <aside class="panel hero-panel stack">
        <span class="brand-chip">What SEED stands for</span>
        <h2>Supporting Educators in Effective Development.</h2>
        <p>
          Not a blog. Not a course. A curated, growing collection of practical resources
          designed for teachers who want to improve their practice without the noise.
        </p>
        <div class="hero-support">
          <div class="micro-grid">
            <div class="micro-card">
              <strong>Practical</strong>
              <p>Tools and ideas you can use in your next lesson.</p>
            </div>
            <div class="micro-card">
              <strong>Real</strong>
              <p>Built from actual classroom experience, not theory.</p>
            </div>
            <div class="micro-card">
              <strong>Growing</strong>
              <p>New resources added regularly as teaching evolves.</p>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Featured Resources</span>
          <h2>Ready to download and use today.</h2>
        </div>
        <a class="button-secondary" href={withBase("/resources")}>See all resources</a>
      </div>
      <div class="resources-grid">
        {featuredResources.map((resource) => <ResourceCard {...resource} />)}
      </div>
    </div>
  </section>

  <!-- Founder bio -->
  <section class="section">
    <div class="shell bio-section">
      <div class="bio-image-wrap">
        <div class="bio-image-placeholder">
          <span class="bio-initials">L</span>
        </div>
        <div class="bio-location">📍 Nanjing, China</div>
      </div>
      <div class="bio-content stack">
        <span class="eyebrow">The person behind SEED</span>
        <h2>Hi, I'm Lee.</h2>
        <p>
          I'm a primary PE, movement, and wellbeing educator living and teaching in Nanjing, China.
          I created The SEED Lab as a home for the ideas, resources, reflections, and classroom
          experiments that grow out of my work with children, teachers, and school communities.
        </p>
        <p class="accent-note">
          How do we help young people feel safe, connected, capable, and ready to grow?
        </p>
        <p>
          For me, PE is about much more than sport. It is a space where children learn how to move,
          cooperate, solve problems, manage challenge, understand their bodies, and discover what kind
          of teammate, learner, and person they are becoming.
        </p>
        <p>
          This is not a showroom. It is a small educational greenhouse. Some ideas are fully grown,
          some are still sprouting, and some are here simply because they might help someone else
          start something useful.
        </p>
        <div class="bio-actions">
          <a class="button-secondary" href={withBase("/blog")}>Read the blog →</a>
          <a class="button" href={withBase("/say-hello")}>Say hello</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell two-column">
      <div class="quote-card stack">
        <span class="eyebrow">Inside my classroom</span>
        <h2>Real teaching. Real examples. No polish.</h2>
        <p>
          See how curriculum design, assessment, daily routines, and classroom systems
          actually work in practice — from planning through to reflection.
        </p>
        <a class="button-secondary" href={withBase("/classroom")} style="width: fit-content; margin-top: 0.5rem;">Take a look →</a>
      </div>
      <div class="panel split-callout stack">
        <span class="eyebrow">Say hello</span>
        <h3>Have a resource request or an idea?</h3>
        <p>
          The SEED Lab grows through genuine teacher needs. If there's something you'd find
          useful — a template, a strategy, a planning tool — get in touch.
        </p>
        <a class="button" href={withBase("/say-hello")} style="width: fit-content; margin-top: 0.5rem;">Get in touch</a>
      </div>
    </div>
  </section>

</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResourceCard from "../components/ResourceCard.astro";
import resources from "../data/resources.json";
import site from "../data/site.json";
import { withBase } from "../utils/withBase";

const featuredResources = resources.filter((resource) => resource.featured).slice(0, 3);
---

<BaseLayout title="Home" description={site.description}>

  <!-- ── HERO ── -->
  <section class="hero-cosmic" aria-label="Welcome to The SEED Lab">
    <!-- Starfield -->
    <div class="star-field" aria-hidden="true">
      <div class="stars stars-1"></div>
      <div class="stars stars-2"></div>
      <div class="stars stars-3"></div>
    </div>

    <!-- Constellation accent lines -->
    <svg class="constellation" aria-hidden="true" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
      <g stroke="rgba(125,211,252,0.12)" stroke-width="1" fill="none">
        <line x1="80"  y1="120" x2="220" y2="80"/>
        <line x1="220" y1="80"  x2="310" y2="160"/>
        <line x1="310" y1="160" x2="180" y2="220"/>
        <line x1="180" y1="220" x2="80"  y2="120"/>
        <line x1="900" y1="80"  x2="1050" y2="140"/>
        <line x1="1050" y1="140" x2="1120" y2="60"/>
        <line x1="1050" y1="140" x2="980"  y2="260"/>
      </g>
      <g fill="rgba(125,211,252,0.3)">
        <circle cx="80"   cy="120" r="1.5"/>
        <circle cx="220"  cy="80"  r="2"/>
        <circle cx="310"  cy="160" r="1.5"/>
        <circle cx="180"  cy="220" r="1"/>
        <circle cx="900"  cy="80"  r="1.5"/>
        <circle cx="1050" cy="140" r="2"/>
        <circle cx="1120" cy="60"  r="1"/>
        <circle cx="980"  cy="260" r="1.5"/>
      </g>
    </svg>

    <!-- Glowing seed motif -->
    <div class="seed-motif" aria-hidden="true">
      <svg viewBox="0 0 80 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="40" cy="68" rx="12" ry="16" fill="rgba(127,176,105,0.15)" stroke="rgba(127,176,105,0.6)" stroke-width="1.2"/>
        <path d="M40 52 Q40 32 40 20" stroke="rgba(167,199,136,0.7)" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M40 38 Q28 30 22 18 Q34 22 40 38Z" fill="rgba(127,176,105,0.25)" stroke="rgba(127,176,105,0.5)" stroke-width="0.8"/>
        <path d="M40 32 Q52 24 58 12 Q46 16 40 32Z" fill="rgba(127,176,105,0.25)" stroke="rgba(127,176,105,0.5)" stroke-width="0.8"/>
        <ellipse cx="40" cy="68" rx="5" ry="6" fill="rgba(167,199,136,0.4)"/>
      </svg>
    </div>

    <!-- Hero content -->
    <div class="shell hero-content">
      <div class="hero-inner">
        <span class="eyebrow anim-rise anim-d1">Practical PE · Wellbeing · Classroom Connection</span>

        <h1 class="hero-title anim-rise anim-d2">
          The SEED Lab
        </h1>

        <p class="hero-lead anim-rise anim-d3">
          Practical PE, wellbeing, and classroom resources grown from real teaching,
          curious children, and the occasional lesson that went beautifully sideways.
        </p>

        <p class="hero-sub anim-rise anim-d4">
          Helping children feel safe, connected, capable, and ready to grow.
        </p>

        <div class="hero-actions anim-rise anim-d5">
          <a class="button-terra" href={withBase("/resources")}>Explore the Resources</a>
          <a class="button-ghost" href={withBase("/blog")}>Read the Field Notes</a>
        </div>

        <p class="hero-trust anim-rise anim-d6">
          <span class="trust-pip"></span> Classroom-tested
          <span class="trust-pip"></span> Teacher-friendly
          <span class="trust-pip"></span> Still growing
        </p>
      </div>
    </div>
  </section>

  <style>
    /* ── Cosmic hero ── */
    .hero-cosmic {
      position: relative;
      background: radial-gradient(ellipse 80% 60% at 50% 0%, #1a2f55 0%, var(--deep-navy) 50%, var(--space-black) 100%);
      min-height: 88vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 6rem 0 5rem;
    }

    .star-field {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .stars {
      position: absolute;
      inset: 0;
      background-repeat: repeat;
    }

    .stars-1 {
      background-image:
        radial-gradient(1px 1px at 10% 8%, rgba(255,255,255,0.85) 0%, transparent 100%),
        radial-gradient(1px 1px at 25% 22%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 38% 6%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 52% 18%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 67% 4%, rgba(255,255,255,0.8) 0%, transparent 100%),
        radial-gradient(1px 1px at 80% 14%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 91% 9%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 14% 35%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 43% 42%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 72% 38%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1px 1px at 88% 30%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 6%  55%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 30% 62%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1px 1px at 58% 58%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 76% 72%, rgba(255,255,255,0.3) 0%, transparent 100%),
        radial-gradient(1px 1px at 95% 65%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 18% 80%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1px 1px at 46% 88%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 83% 90%, rgba(255,255,255,0.3) 0%, transparent 100%);
      background-size: 100% 100%;
      opacity: 0.8;
    }

    .stars-2 {
      background-image:
        radial-gradient(1.5px 1.5px at 5%  12%, rgba(248,244,232,0.9) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 33% 3%,  rgba(248,244,232,0.7) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 60% 28%, rgba(248,244,232,0.8) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 78% 5%,  rgba(248,244,232,0.6) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 92% 44%, rgba(248,244,232,0.7) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 20% 52%, rgba(125,211,252,0.5) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 55% 75%, rgba(248,244,232,0.5) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 40% 92%, rgba(248,244,232,0.4) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 70% 85%, rgba(125,211,252,0.4) 0%, transparent 100%);
      background-size: 100% 100%;
      opacity: 0.9;
      animation: slow-drift 60s linear infinite alternate;
    }

    .stars-3 {
      background-image:
        radial-gradient(2px 2px at 15% 25%, rgba(242,199,102,0.5) 0%, transparent 100%),
        radial-gradient(2px 2px at 50% 10%, rgba(255,255,255,0.9) 0%, transparent 100%),
        radial-gradient(2px 2px at 85% 20%, rgba(242,199,102,0.4) 0%, transparent 100%),
        radial-gradient(2px 2px at 25% 70%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(2px 2px at 65% 50%, rgba(167,199,136,0.5) 0%, transparent 100%),
        radial-gradient(2px 2px at 90% 75%, rgba(255,255,255,0.6) 0%, transparent 100%);
      background-size: 100% 100%;
      opacity: 0.7;
      animation: slow-drift 90s linear infinite alternate-reverse;
    }

    @keyframes slow-drift {
      from { transform: translateX(0) translateY(0); }
      to   { transform: translateX(8px) translateY(-6px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .stars-2, .stars-3 { animation: none; }
    }

    .constellation {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .seed-motif {
      position: absolute;
      right: 8%;
      top: 50%;
      transform: translateY(-50%);
      width: clamp(120px, 14vw, 200px);
      opacity: 0.55;
      filter: drop-shadow(0 0 20px rgba(127,176,105,0.4)) drop-shadow(0 0 40px rgba(127,176,105,0.2));
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .hero-inner {
      max-width: 680px;
    }

    .hero-title {
      font-family: "Fraunces", serif;
      font-size: clamp(3.2rem, 7vw, 5.5rem);
      font-weight: 600;
      color: var(--starlight);
      line-height: 1.02;
      margin: 0.5rem 0 0;
      letter-spacing: -0.02em;
      text-shadow: 0 2px 40px rgba(7,10,18,0.4);
    }

    .hero-lead {
      font-size: clamp(1.05rem, 2vw, 1.2rem);
      color: rgba(243, 232, 208, 0.85);
      max-width: 58ch;
      line-height: 1.75;
      margin-top: 1.5rem;
    }

    .hero-sub {
      font-family: "Fraunces", serif;
      font-style: italic;
      font-size: clamp(1rem, 1.8vw, 1.15rem);
      color: var(--growth-green);
      margin-top: 0.75rem;
      max-width: 52ch;
      line-height: 1.5;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 2.25rem;
    }

    .hero-trust {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 1.75rem;
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(243, 232, 208, 0.45);
      max-width: none;
    }

    .trust-pip {
      display: inline-block;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--seed-green);
      box-shadow: 0 0 5px var(--seed-green);
      flex-shrink: 0;
    }

    @media (max-width: 820px) {
      .seed-motif { display: none; }
      .hero-cosmic { min-height: auto; padding: 5rem 0 4rem; }
    }
  </style>

  <!-- ── 1. WHAT THIS PLACE IS ── -->
  <section class="section hp-intro">
    <div class="shell">
      <div class="intro-grid">
        <div class="intro-text stack">
          <span class="eyebrow">What this place is</span>
          <h2>A little educational greenhouse for PE, play, wellbeing, and classroom connection.</h2>
          <p>
            The SEED Lab is where I gather practical resources, visual tools, reflections, and
            classroom experiments from my work with children, teachers, and school communities.
          </p>
          <p>
            Some ideas are polished. Some are still sprouting. Some are here because they might
            help another teacher start something useful.
          </p>
        </div>
        <div class="intro-values">
          <div class="value-item">
            <span class="value-icon" aria-hidden="true">🌱</span>
            <div>
              <strong>Practical</strong>
              <p>Tools built for real classrooms, not imaginary ones where everyone listens the first time.</p>
            </div>
          </div>
          <div class="value-item">
            <span class="value-icon" aria-hidden="true">🔬</span>
            <div>
              <strong>Evidence-informed</strong>
              <p>Rooted in child development, movement science, and what actually works on a Tuesday.</p>
            </div>
          </div>
          <div class="value-item">
            <span class="value-icon" aria-hidden="true">✦</span>
            <div>
              <strong>Generous</strong>
              <p>Take what helps. Adapt what you need. Grow it in your own way.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. THREE PATHWAYS ── -->
  <section class="section-cosmic hp-pathways">
    <div class="shell">
      <div class="pathway-header">
        <span class="eyebrow cosmic">Find your way in</span>
        <h2 class="cosmic-heading">Three ways to explore the archive</h2>
      </div>
      <div class="pathway-grid">

        <a class="pathway-card" href={withBase("/resources")}>
          <div class="pathway-icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none"><rect x="6" y="8" width="28" height="4" rx="2" fill="currentColor" opacity="0.6"/><rect x="6" y="16" width="22" height="4" rx="2" fill="currentColor" opacity="0.4"/><rect x="6" y="24" width="26" height="4" rx="2" fill="currentColor" opacity="0.6"/><rect x="6" y="32" width="16" height="4" rx="2" fill="currentColor" opacity="0.3"/></svg>
          </div>
          <div class="pathway-body">
            <span class="pathway-label">Resources</span>
            <p class="pathway-sub">Practical tools from the archive.</p>
            <p>Prompt cards, visual guides, infographics, planning tools, and classroom-ready resources — all free, all tested.</p>
          </div>
          <span class="pathway-cta">Open the Resource Shelf →</span>
        </a>

        <a class="pathway-card pathway-card--gold" href={withBase("/blog")}>
          <div class="pathway-icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none"><path d="M8 34 L8 10 Q8 8 10 8 L30 8 Q32 8 32 10 L32 34 L20 28 L8 34Z" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.7"/><line x1="14" y1="16" x2="26" y2="16" stroke="currentColor" stroke-width="1.5" opacity="0.5"/><line x1="14" y1="21" x2="23" y2="21" stroke="currentColor" stroke-width="1.5" opacity="0.4"/></svg>
          </div>
          <div class="pathway-body">
            <span class="pathway-label">Field Notes</span>
            <p class="pathway-sub">Reflections from the gym floor.</p>
            <p>Real teaching stories, honest reflections, and ideas still being tested. For lessons that wobble before they bloom.</p>
          </div>
          <span class="pathway-cta">Read the Field Notes →</span>
        </a>

        <a class="pathway-card pathway-card--green" href={withBase("/classroom")}>
          <div class="pathway-icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="12" stroke="currentColor" stroke-width="1.5" opacity="0.5"/><circle cx="20" cy="20" r="6" stroke="currentColor" stroke-width="1.5" opacity="0.7"/><circle cx="20" cy="20" r="2" fill="currentColor" opacity="0.9"/><line x1="20" y1="4" x2="20" y2="8" stroke="currentColor" stroke-width="1.5" opacity="0.4"/><line x1="20" y1="32" x2="20" y2="36" stroke="currentColor" stroke-width="1.5" opacity="0.4"/><line x1="4" y1="20" x2="8" y2="20" stroke="currentColor" stroke-width="1.5" opacity="0.4"/><line x1="32" y1="20" x2="36" y2="20" stroke="currentColor" stroke-width="1.5" opacity="0.4"/></svg>
          </div>
          <div class="pathway-body">
            <span class="pathway-label">Inside My Classroom</span>
            <p class="pathway-sub">Systems, routines, and learning in motion.</p>
            <p>The real practice behind the resources — planning, assessment, agreements, and classroom culture.</p>
          </div>
          <span class="pathway-cta">Step Inside the Classroom →</span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── 3. FRESH FROM THE LAB ── -->
  <section class="section hp-featured">
    <div class="shell">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Fresh from the Lab</span>
          <h2>Ready to try tomorrow.</h2>
        </div>
        <a class="button-secondary" href={withBase("/resources")}>Browse the Archive</a>
      </div>
      <div class="resources-grid">
        {featuredResources.map((resource) => <ResourceCard {...resource} />)}
      </div>
    </div>
  </section>

  <!-- ── 4. WHY THIS EXISTS ── -->
  <section class="section-cosmic hp-why">
    <div class="shell">
      <div class="why-grid">
        <div class="why-copy">
          <span class="eyebrow cosmic">Why The SEED Lab exists</span>
          <h2 class="cosmic-heading">More than sport.<br/>More than fitness.</h2>
          <p class="why-lead">
            At the heart of my teaching is a simple question:
          </p>
          <p class="why-question">
            How do we help young people feel safe, connected, capable, and ready to grow?
          </p>
          <p>
            For me, PE is a place where children learn how to move, cooperate, solve problems,
            manage challenge, understand their bodies, and discover what kind of teammate,
            learner, and person they are becoming.
          </p>
          <p>
            The SEED Lab is where I gather and share the things I'm learning along the way.
          </p>
        </div>
        <div class="why-principles">
          <div class="principle-card">
            <span class="principle-word">Safe</span>
            <p>Every child deserves to feel physically and emotionally safe before they can learn.</p>
          </div>
          <div class="principle-card">
            <span class="principle-word">Connected</span>
            <p>Belonging matters. Relationships are the foundation that everything else grows from.</p>
          </div>
          <div class="principle-card">
            <span class="principle-word">Capable</span>
            <p>Children need to experience genuine challenge — and discover they can meet it.</p>
          </div>
          <div class="principle-card">
            <span class="principle-word">Growing</span>
            <p>Learning is a process. So is teaching. This site is proof of that.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 5. LEE INTRO ── -->
  <section class="section hp-lee">
    <div class="shell bio-section">
      <div class="bio-image-wrap">
        <img src="/lee-and-gatis.jpg" alt="Lee, a primary PE and wellbeing educator" class="bio-photo" loading="lazy" />
        <div class="bio-location">📍 Nanjing, China</div>
      </div>
      <div class="bio-content stack">
        <span class="eyebrow">The person behind The SEED Lab</span>
        <h2>Hi, I'm Lee.</h2>
        <p>
          I'm a primary PE, movement, and wellbeing educator living and teaching in Nanjing, China.
          I created The SEED Lab as a home for the ideas, resources, reflections, and classroom
          experiments that grow out of my work with children, teachers, and school communities.
        </p>
        <p class="accent-note">
          This is not a showroom. It is a little educational greenhouse. Some ideas are fully grown,
          some are still sprouting, and some are here because they might help someone else
          start something useful.
        </p>
        <div class="bio-actions">
          <a class="button" href={withBase("/blog")}>Read the Field Notes</a>
          <a class="button-secondary" href={withBase("/say-hello")}>Say Hello</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 6. FINAL CTA ── -->
  <section class="section-cosmic hp-cta">
    <div class="shell">
      <div class="cta-panel">
        <div class="cta-seed" aria-hidden="true">✦</div>
        <p class="cta-eyebrow eyebrow cosmic">You're in the right place</p>
        <h2 class="cosmic-heading cta-heading">Take what helps.<br/>Adapt what you need.<br/>Grow it in your own way.</h2>
        <p class="cta-sub">Small seeds for big classroom moments.</p>
        <div class="cta-actions">
          <a class="button-terra" href={withBase("/resources")}>Explore the Resources</a>
          <a class="button-ghost" href={withBase("/say-hello")}>Say Hello</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ══════════════════════════════════════
       PLANET SURFACES & GALAXY NEBULAE
       Homepage-scoped world-building
       ══════════════════════════════════════ */

    /* ── Hero: nebula depth layers on existing gradient ── */
    .hero-cosmic::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 55% 50% at 85% 15%, rgba(90,40,130,0.28) 0%, transparent 65%),
        radial-gradient(ellipse 40% 35% at 15% 75%, rgba(20,100,130,0.22) 0%, transparent 60%),
        radial-gradient(ellipse 30% 25% at 60% 85%, rgba(60,20,100,0.18) 0%, transparent 55%);
      pointer-events: none;
      z-index: 0;
    }

    /* ── Section 1: Desert World ──
       Warm sandy ochre — like a dry, sun-baked moon.
       Gold limb-glow creeping in from the top-right. */
    .hp-intro {
      background:
        radial-gradient(ellipse 55% 40% at 100% 0%, rgba(200,158,60,0.10) 0%, transparent 65%),
        radial-gradient(ellipse 30% 25% at 0% 100%, rgba(160,120,50,0.06) 0%, transparent 60%),
        #EDE5CC;
    }

    /* ── Section 2: Galaxy — indigo nebula ──
       Violet cloud blooming from the top-right corner. */
    .hp-pathways {
      background:
        radial-gradient(ellipse 55% 65% at 90% 10%, rgba(90,30,140,0.40) 0%, transparent 60%),
        radial-gradient(ellipse 40% 30% at 10% 90%, rgba(20,80,130,0.28) 0%, transparent 55%),
        var(--midnight-blue);
    }

    /* ── Section 3: Verdant World ──
       Cool sage-green — a living, mossy planet.
       Soft green atmosphere breathes in from the bottom-left. */
    .hp-featured {
      background:
        radial-gradient(ellipse 50% 40% at 0% 100%, rgba(80,140,80,0.10) 0%, transparent 65%),
        radial-gradient(ellipse 35% 30% at 100% 0%, rgba(100,160,100,0.07) 0%, transparent 60%),
        #DCE8D4;
    }

    /* ── Section 4: Galaxy — teal nebula ──
       Cyan-teal cloud rising from the bottom-left. */
    .hp-why {
      background:
        radial-gradient(ellipse 50% 55% at 15% 80%, rgba(20,110,130,0.38) 0%, transparent 60%),
        radial-gradient(ellipse 35% 30% at 85% 15%, rgba(70,20,110,0.25) 0%, transparent 55%),
        var(--midnight-blue);
    }

    /* ── Section 5: Ice World ──
       Pale blue-grey — mineral, crisp, distant.
       Cool blue glow drifting in from the bottom-right. */
    .hp-lee {
      background:
        radial-gradient(ellipse 50% 40% at 100% 100%, rgba(70,110,180,0.09) 0%, transparent 65%),
        radial-gradient(ellipse 30% 25% at 0% 0%, rgba(100,140,200,0.06) 0%, transparent 55%),
        #E2E8F2;
    }

    /* ── Section 6: Galaxy — deep violet CTA ──
       Central violet bloom — the heart of the galaxy. */
    .hp-cta {
      background:
        radial-gradient(ellipse 70% 60% at 50% 40%, rgba(80,25,120,0.45) 0%, transparent 65%),
        radial-gradient(ellipse 40% 30% at 90% 90%, rgba(20,80,130,0.30) 0%, transparent 55%),
        radial-gradient(ellipse 30% 25% at 10% 10%, rgba(30,20,80,0.25) 0%, transparent 50%),
        var(--space-black);
    }

    /* ── What This Place Is ── */
    .hp-intro { }

    .intro-grid {
      display: grid;

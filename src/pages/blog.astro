---
import BaseLayout from "../layouts/BaseLayout.astro";
import posts from "../data/blog-posts.json";
---

<BaseLayout title="Blog" description="Practical teaching reflections and classroom insights from The SEED Lab — short, honest posts for busy primary and IB educators.">
  <section class="page-hero">
    <div class="shell stack">
      <span class="eyebrow">Blog</span>
      <h1>Short posts for calm, practical teaching.</h1>
      <p>
        The blog is intentionally light in this first version: just enough room for thoughtful
        writing without overcomplicating the project.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell blog-grid">
      {posts.map((post) => (
        <article class="blog-card stack" id={post.slug}>
          <div class="blog-meta">
            <span class="pill">Short Blog Post</span>
            <span>{post.date}</span>
          </div>
          <h2>{post.title}</h2>
          <p>{post.summary}</p>
          <div class="stack">
            {post.content.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

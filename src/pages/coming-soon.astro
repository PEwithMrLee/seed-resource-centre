---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Coming Soon"
  description="A preview of the areas SEED can expand into over time."
>
  <section class="page-hero">
    <div class="shell two-column">
      <div class="stack">
        <span class="eyebrow">Coming Soon</span>
        <h1>Gentle room to grow.</h1>
        <p>
          SEED is intentionally starting small. Future sections can be added once the teacher
          resource library is working well and the needs are clearer.
        </p>
      </div>
      <div class="panel stack">
        <span class="eyebrow">Possible additions</span>
        <h3>Ideas for the next phase</h3>
        <ul class="list-clean">
          <li>Collections by age group or topic</li>
          <li>Parent-friendly guides and home support printables</li>
          <li>Student-friendly learning prompts and revision tools</li>
          <li>Newsletter sign-up or a simple contact page</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

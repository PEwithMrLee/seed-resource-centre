---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Say Hello"
  description="Got a question, idea, reflection, or classroom story? The SEED Lab is a small, teacher-run project and every message is read personally."
>

  <!-- ── Hero ── -->
  <section class="sh-hero">
    <div class="shell">
      <div class="sh-hero-inner">
        <span class="eyebrow cosmic">Say Hello</span>
        <h1 class="sh-title">Got something on your mind?</h1>
        <p class="sh-lead">
          Got a question, idea, reflection, or classroom story? I'd love to hear from you.
          Every message is read personally — no auto-replies, no ticketing systems.
        </p>
        <div class="sh-reasons">
          <span class="reason-item">✦ Resource requests</span>
          <span class="reason-item">✦ Collaboration ideas</span>
          <span class="reason-item">✦ Feedback on anything here</span>
          <span class="reason-item">✦ Just saying hello</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Form section ── -->
  <section class="section sh-section">
    <div class="shell">
      <div class="contact-layout">

        <!-- Form -->
        <div class="contact-main">
          <form
            class="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            id="contact-form"
            novalidate
          >

            <!-- Success state -->
            <div class="form-success" id="form-success" hidden aria-live="polite">
              <span class="success-icon" aria-hidden="true">✦</span>
              <p class="success-heading">Your message has landed safely.</p>
              <p class="success-sub">Thanks for reaching out. I'll get back to you within a few days.</p>
            </div>

            <!-- Error state -->
            <div class="form-error" id="form-error" hidden aria-live="assertive">
              <p>Something wobbled. Please check the details and try again.</p>
            </div>

            <div class="form-fields" id="form-fields">
              <div class="form-group">
                <label for="name">Your name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder="First name is fine"
                  autocomplete="given-name"
                  required
                />
              </div>

              <div class="form-group">
                <label for="email">Email address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="you@school.edu"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="form-group">
                <label for="reason">What's this about?</label>
                <select id="reason" name="reason">
                  <option value="">Choose a reason — or skip</option>
                  <option value="resource-request">I'd love a resource for something specific</option>
                  <option value="collaboration">I have a collaboration idea</option>
                  <option value="feedback">Feedback on something here</option>
                  <option value="general">A general question about teaching</option>
                  <option value="other">Something else entirely</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message">Your message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="What's on your mind?"
                  required
                ></textarea>
              </div>

              <button type="submit" class="button-signal" id="submit-btn">
                Send a Signal →
              </button>
            </div>

          </form>
        </div>

        <!-- Aside -->
        <aside class="contact-aside">
          <div class="panel stack">
            <span class="eyebrow">Direct email</span>
            <h2>Prefer email?</h2>
            <p>Reach out directly at any time — it comes straight to me.</p>
            <a class="email-link" href="mailto:hello@theseedlab.org">hello@theseedlab.org</a>
          </div>

          <div class="panel stack">
            <span class="eyebrow">Response time</span>
            <h2>When to expect a reply</h2>
            <p>
              The SEED Lab is a one-person project run alongside full-time teaching.
              Replies usually arrive within a few days — sometimes sooner.
            </p>
          </div>

          <div class="panel panel-dark stack">
            <span class="eyebrow cosmic">A small reminder</span>
            <p class="panel-dark-text">
              "Classroom-tested. Teacher-friendly. Still growing."
            </p>
            <p class="panel-dark-sub">
              The SEED Lab is designed to stay simple now and grow purposefully over time.
            </p>
          </div>
        </aside>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const fields = document.getElementById('form-fields');
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorEl) errorEl.hidden = true;

      if (submitBtn) {
        submitBtn.textContent = 'Sending…';
        submitBtn.disabled = true;
      }

      try {
        const data = new FormData(form);
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as any).toString(),
        });

        if (res.ok) {
          if (fields) fields.hidden = true;
          if (successEl) successEl.hidden = false;
        } else {
          throw new Error('Non-OK response');
        }
      } catch {
        if (errorEl) errorEl.hidden = false;
        if (submitBtn) {
          submitBtn.textContent = 'Send a Signal →';
          submitBtn.disabled = false;
        }
      }
    });
  }
</script>

<style>
  /* ── Hero ── */
  .sh-hero {
    background:
      radial-gradient(ellipse 55% 50% at 85% 20%, rgba(90,40,130,0.25) 0%, transparent 65%),
      radial-gradient(ellipse 40% 35% at 15% 75%, rgba(20,100,130,0.20) 0%, transparent 60%),
      radial-gradient(ellipse 80% 65% at 50% 0%, #1a2f55 0%, var(--deep-navy) 55%, var(--space-black) 100%);
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--line-cosmic);
  }

  .sh-hero-inner { max-width: 620px; }

  .sh-title {
    font-family: "Fraunces", serif;
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    color: var(--starlight);
    line-height: 1.08;
    margin: 0.5rem 0 0;
    letter-spacing: -0.02em;
  }

  .sh-lead {
    font-size: 1.1rem;
    color: rgba(243,232,208,0.8);
    max-width: 52ch;
    margin-top: 1.25rem;
    line-height: 1.75;
  }

  .sh-reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.75rem;
  }

  .reason-item {
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(243,232,208,0.55);
  }

  /* ── Layout ── */
  .sh-section {
    background:
      radial-gradient(ellipse 50% 40% at 5% 95%, rgba(80,140,80,0.08) 0%, transparent 65%),
      radial-gradient(ellipse 35% 30% at 95% 5%, rgba(100,160,100,0.05) 0%, transparent 60%),
      var(--bg-soft);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.4fr 0.75fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* ── Form ── */
  .contact-form { display: flex; flex-direction: column; gap: 0; }

  .form-fields {
    display: grid;
    gap: 1.25rem;
  }

  .form-group {
    display: grid;
    gap: 0.45rem;
  }

  .form-group label {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: "Atkinson Hyperlegible", sans-serif;
    font-size: 1rem;
    color: var(--text);
    background: rgba(255, 253, 249, 0.95);
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    width: 100%;
    transition: border-color 200ms ease, box-shadow 200ms ease;
    outline: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--seed-green);
    box-shadow: 0 0 0 3px rgba(127,176,105,0.15);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 130px;
    line-height: 1.65;
  }

  /* ── Submit button ── */
  .button-signal {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.75rem;
    background: var(--lantern-gold);
    color: var(--space-black);
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    width: fit-content;
    transition: background 200ms ease, box-shadow 200ms ease, transform 160ms ease;
  }

  .button-signal:hover {
    background: var(--lantern-gold-deep);
    box-shadow: 0 0 20px rgba(242,199,102,0.35);
    transform: translateY(-1px);
  }

  .button-signal:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  /* ── Success state ── */
  .form-success {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 2.5rem;
    background: rgba(127,176,105,0.08);
    border: 1.5px solid rgba(127,176,105,0.3);
    border-radius: var(--radius);
  }

  .success-icon {
    font-size: 1.75rem;
    color: var(--seed-green);
    filter: drop-shadow(0 0 8px rgba(127,176,105,0.4));
  }

  .success-heading {
    font-family: "Fraunces", serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }

  .success-sub {
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Error state ── */
  .form-error {
    padding: 1rem 1.25rem;
    background: rgba(220, 80, 60, 0.07);
    border: 1.5px solid rgba(220, 80, 60, 0.25);
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
  }

  .form-error p {
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.9rem;
    color: #b84040;
    margin: 0;
    max-width: none;
  }

  /* ── Aside ── */
  .contact-aside {
    position: sticky;
    top: 7rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .email-link {
    display: inline-flex;
    color: var(--accent-deep);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 1rem;
    word-break: break-all;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .email-link:hover { color: var(--lantern-gold-deep); }

  /* ── Dark panel ── */
  .panel-dark {
    background: var(--midnight-blue);
    border-color: var(--line-cosmic) !important;
  }

  .panel-dark-text {
    font-family: "Fraunces", serif;
    font-style: italic;
    font-size: 1rem;
    color: var(--lantern-gold);
    line-height: 1.5;
    margin: 0;
    max-width: none;
  }

  .panel-dark-sub {
    font-size: 0.88rem;
    color: var(--muted-on-dark);
    line-height: 1.6;
    margin: 0;
    max-width: none;
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .contact-aside {
      position: static;
    }
  }
</style>

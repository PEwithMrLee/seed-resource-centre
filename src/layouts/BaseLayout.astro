---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = site.description,
  currentPath = Astro.url.pathname
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #fbf7f1;
        --surface: rgba(255, 252, 247, 0.9);
        --surface-strong: #fffdf9;
        --line: rgba(106, 88, 68, 0.16);
        --text: #2f261f;
        --muted: #6e6257;
        --accent: #8b6b4f;
        --accent-soft: #efe3d2;
        --shadow: 0 24px 60px rgba(68, 51, 35, 0.08);
        --radius: 24px;
        --radius-sm: 16px;
        --shell: min(1120px, calc(100vw - 3rem));
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Manrope", sans-serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(236, 221, 197, 0.55), transparent 28%),
          linear-gradient(180deg, #f9f4ec 0%, var(--bg) 42%, #f6f0e7 100%);
        line-height: 1.65;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      main {
        display: block;
      }

      .shell {
        width: var(--shell);
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(18px);
        background: rgba(251, 247, 241, 0.78);
        border-bottom: 1px solid rgba(106, 88, 68, 0.08);
      }

      .nav-wrap,
      .footer-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
      }

      .nav-wrap {
        min-height: 5rem;
      }

      .brand {
        display: inline-flex;
        align-items: baseline;
        gap: 0.75rem;
      }

      .brand-mark {
        font-family: "Newsreader", serif;
        font-size: 1.8rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .brand-text,
      .eyebrow,
      .meta-text {
        color: var(--muted);
        font-size: 0.95rem;
      }

      .nav-list {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav-link {
        display: inline-flex;
        padding: 0.6rem 0.95rem;
        border-radius: 999px;
        color: var(--muted);
        transition: background-color 180ms ease, color 180ms ease;
      }

      .nav-link:hover,
      .nav-link.active {
        background: var(--accent-soft);
        color: var(--text);
      }

      .hero,
      .page-hero {
        padding: 5.5rem 0 2rem;
      }

      .hero-grid,
      .two-column {
        display: grid;
        grid-template-columns: 1.3fr 0.9fr;
        gap: 2rem;
        align-items: start;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
      }

      h1,
      h2,
      h3 {
        font-family: "Newsreader", serif;
        line-height: 1.05;
        margin: 0;
        font-weight: 500;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: clamp(3.2rem, 8vw, 6rem);
        max-width: 12ch;
      }

      h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 1rem;
      }

      h3 {
        font-size: 1.6rem;
        margin-bottom: 0.6rem;
      }

      p {
        margin: 0;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .hero-copy p,
      .page-hero p {
        max-width: 62ch;
        font-size: 1.1rem;
      }

      .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 2rem;
      }

      .button,
      .button-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.2rem;
        padding: 0.9rem 1.3rem;
        border-radius: 999px;
        border: 1px solid transparent;
        font-weight: 600;
      }

      .button {
        background: var(--text);
        color: #fdf9f3;
      }

      .button-secondary {
        border-color: var(--line);
        background: rgba(255, 255, 255, 0.55);
      }

      .panel,
      .feature-card,
      .resource-card,
      .blog-card,
      .quote-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .panel,
      .quote-card {
        padding: 1.8rem;
      }

      .feature-grid,
      .resources-grid,
      .blog-grid {
        display: grid;
        gap: 1.25rem;
      }

      .feature-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resources-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .blog-grid {
        grid-template-columns: 1fr;
      }

      .section {
        padding: 2.5rem 0 5rem;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .feature-card,
      .blog-card,
      .resource-card {
        padding: 1.5rem;
      }

      .feature-card p,
      .blog-card p,
      .resource-card p,
      .quote-card p {
        font-size: 1rem;
      }

      .resource-meta,
      .blog-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 1rem;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .resource-meta span,
      .resource-category,
      .pill {
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        background: var(--accent-soft);
      }

      .resource-tagline {
        color: var(--text);
        margin-bottom: 0.7rem;
      }

      .resource-footer,
      .card-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.25rem;
      }

      .resource-footer a,
      .card-link a {
        color: var(--accent);
        font-weight: 600;
      }

      .split-callout {
        padding: 2rem;
      }

      .site-footer {
        padding: 2rem 0 3rem;
      }

      .footer-wrap {
        padding-top: 1.5rem;
        border-top: 1px solid rgba(106, 88, 68, 0.12);
        align-items: flex-start;
      }

      .stack {
        display: grid;
        gap: 1rem;
      }

      .list-clean {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      .muted {
        color: var(--muted);
      }

      @media (max-width: 900px) {
        .hero-grid,
        .two-column,
        .feature-grid,
        .resources-grid {
          grid-template-columns: 1fr;
        }

        .site-header {
          position: static;
        }

        .nav-wrap,
        .footer-wrap,
        .section-head {
          align-items: flex-start;
          flex-direction: column;
        }

        h1 {
          max-width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = site.description,
  currentPath = Astro.url.pathname
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />

    <!-- Canonical & indexing -->
    <link rel="canonical" href={`https://theseedlab.org${currentPath}`} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph (social sharing) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The SEED Lab" />
    <meta property="og:title" content={`${title} | The SEED Lab`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://theseedlab.org${currentPath}`} />
    <meta property="og:image" content="https://theseedlab.org/seed-logo.png" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | The SEED Lab`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://theseedlab.org/seed-logo.png" />

    <!-- Authorship & theme -->
    <meta name="author" content="The SEED Lab" />
    <meta name="theme-color" content="#3a5e3a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* Core palette */
        --bg: #faf8f3;
        --bg-soft: #e8efe4;
        --surface: rgba(255, 253, 248, 0.92);
        --surface-strong: rgba(255, 253, 249, 0.98);
        --surface-moss: rgba(236, 244, 232, 0.88);

        /* Borders */
        --line: rgba(80, 105, 75, 0.15);
        --line-strong: rgba(80, 105, 75, 0.26);

        /* Text */
        --text: #2c2c2c;
        --muted: #666;

        /* Brand greens */
        --accent: #4a7c59;
        --accent-deep: #3a5e3a;
        --accent-soft: #d8e8d4;

        /* Terracotta accent for CTAs */
        --terra: #c47b4a;
        --terra-deep: #a85f30;
        --terra-soft: #f5e8dc;

        /* Shadows */
        --shadow: 0 24px 60px rgba(40, 65, 40, 0.10);
        --shadow-soft: 0 8px 32px rgba(40, 65, 40, 0.07);
        --shadow-hover: 0 16px 48px rgba(40, 65, 40, 0.14);

        /* Shape */
        --radius: 16px;
        --radius-sm: 10px;
        --radius-lg: 24px;
        --shell: min(1120px, calc(100vw - 3rem));
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "DM Sans", sans-serif;
        font-size: 1.05rem;
        color: var(--text);
        background: var(--bg);
        line-height: 1.7;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      main {
        display: block;
      }

      /* ── Layout ── */
      .shell {
        width: var(--shell);
        margin: 0 auto;
      }

      /* ── Header ── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(20px);
        background: rgba(250, 248, 243, 0.88);
        border-bottom: 1px solid var(--line);
        transition: box-shadow 200ms ease;
      }

      .site-header.scrolled {
        box-shadow: 0 2px 20px rgba(40, 65, 40, 0.08);
      }

      .nav-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 5rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        text-decoration: none;
        flex-shrink: 0;
      }

      .brand-mark {
        font-family: "Cormorant Garamond", serif;
        font-size: 1.7rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        color: var(--accent-deep);
        line-height: 1.1;
      }

      .brand-text,
      .meta-text {
        color: var(--muted);
        font-size: 0.9rem;
      }

      .nav-list {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav-link {
        display: inline-flex;
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.95rem;
        font-weight: 500;
        transition:
          background-color 160ms ease,
          color 160ms ease;
        border: 1px solid transparent;
      }

      .nav-link:hover,
      .nav-link.active {
        background: var(--accent-soft);
        color: var(--accent-deep);
      }

      .nav-cta {
        display: inline-flex;
        padding: 0.55rem 1.1rem;
        border-radius: 999px;
        background: var(--accent-deep);
        color: #f8f7f1 !important;
        font-size: 0.95rem;
        font-weight: 600;
        transition: background 160ms ease, transform 160ms ease;
        margin-left: 0.5rem;
      }

      .nav-cta:hover {
        background: var(--accent);
        transform: translateY(-1px);
      }

      /* ── Typography ── */
      .eyebrow {
        display: inline-block;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--terra);
      }

      h1, h2, h3, h4 {
        font-family: "Cormorant Garamond", serif;
        line-height: 1.1;
        margin: 0;
        font-weight: 600;
        color: var(--text);
        letter-spacing: -0.01em;
      }

      h1 {
        font-size: clamp(2.8rem, 6vw, 5rem);
        max-width: 14ch;
        text-wrap: balance;
        line-height: 1.05;
      }

      h2 {
        font-size: clamp(1.9rem, 3.5vw, 2.75rem);
        margin-bottom: 0.75rem;
        line-height: 1.12;
      }

      h3 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        line-height: 1.2;
      }

      p {
        margin: 0;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.75;
        max-width: 68ch;
      }

      strong {
        color: var(--text);
        font-weight: 600;
      }

      /* ── Hero ── */
      .hero,
      .page-hero {
        padding: 6rem 0 3.5rem;
      }

      .hero-grid,
      .two-column {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 3rem;
        align-items: start;
      }

      .hero-copy {
        position: relative;
      }

      .hero-copy p,
      .page-hero p {
        font-size: 1.15rem;
        max-width: 58ch;
      }

      .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 2.5rem;
      }

      /* ── Buttons ── */
      .button,
      .button-secondary,
      .button-terra {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3rem;
        padding: 0.8rem 1.5rem;
        border-radius: 999px;
        border: 1.5px solid transparent;
        font-family: "DM Sans", sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition:
          transform 160ms ease,
          box-shadow 160ms ease,
          background-color 160ms ease,
          border-color 160ms ease;
      }

      .button {
        background: var(--accent-deep);
        color: #f8f7f1;
        box-shadow: 0 8px 24px rgba(58, 94, 58, 0.28);
      }

      .button:hover {
        background: var(--accent);
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(58, 94, 58, 0.32);
      }

      .button-terra {
        background: var(--terra);
        color: #fff;
        box-shadow: 0 8px 24px rgba(196, 123, 74, 0.30);
      }

      .button-terra:hover {
        background: var(--terra-deep);
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(196, 123, 74, 0.36);
      }

      /* ── Bio section ── */
      .bio-section {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 3rem;
        align-items: start;
      }

      .bio-image-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
      }

      .bio-image-placeholder {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent-soft), var(--bg-soft));
        border: 3px solid var(--line-strong);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Cormorant Garamond", serif;
        font-size: 4rem;
        color: var(--accent-deep);
        font-weight: 600;
      }

      .bio-location {
        font-size: 0.85rem;
        color: var(--muted);
        font-weight: 500;
      }

      .bio-content { }

      .bio-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
      }

      .button-secondary {
        border-color: var(--line-strong);
        background: transparent;
        color: var(--text);
      }

      .button-secondary:hover {
        border-color: var(--accent);
        background: var(--accent-soft);
        color: var(--accent-deep);
        transform: translateY(-1px);
      }

      /* ── Cards ── */
      .panel,
      .feature-card,
      .resource-card,
      .blog-card,
      .quote-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow-soft);
        transition: box-shadow 200ms ease, transform 200ms ease;
      }

      .resource-card:hover,
      .blog-card:hover {
        box-shadow: var(--shadow-hover);
        transform: translateY(-3px);
      }

      .panel,
      .quote-card {
        padding: 2rem;
      }

      .feature-card,
      .blog-card,
      .resource-card {
        padding: 1.5rem;
      }

      .feature-card p,
      .blog-card p,
      .resource-card p,
      .quote-card p {
        font-size: 0.98rem;
      }

      /* ── Grids ── */
      .feature-grid,
      .resources-grid,
      .blog-grid {
        display: grid;
        gap: 1.5rem;
      }

      .feature-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resources-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .blog-grid {
        grid-template-columns: 1fr;
      }

      /* ── Sections ── */
      .section {
        padding: 4rem 0 6rem;
      }

      .section-soft {
        position: relative;
        background: var(--bg-soft);
        padding: 4rem 0 6rem;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 2.5rem;
      }

      /* ── Resource cards ── */
      .resource-image {
        width: 100%;
        border-radius: var(--radius-sm);
        margin-bottom: 1.25rem;
        object-fit: cover;
        aspect-ratio: 4 / 3;
      }

      .resource-meta,
      .blog-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        font-size: 0.82rem;
      }

      .resource-meta span,
      .resource-category,
      .pill {
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-deep);
        font-weight: 600;
        font-size: 0.8rem;
      }

      .resource-tagline {
        color: var(--text);
        font-weight: 500;
        margin-bottom: 0.5rem;
        font-size: 0.98rem;
      }

      .resource-footer,
      .card-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
      }

      .resource-footer a,
      .card-link a {
        color: var(--accent);
        font-weight: 600;
        font-size: 0.92rem;
        transition: color 160ms ease;
      }

      .resource-footer a:hover,
      .card-link a:hover {
        color: var(--terra);
      }

      /* ── Misc components ── */
      .split-callout {
        padding: 2rem;
        background: linear-gradient(135deg, rgba(236, 244, 232, 0.9), rgba(255, 253, 248, 0.95));
      }

      .stack {
        display: grid;
        gap: 1rem;
      }

      .list-clean {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.75rem;
      }

      .list-clean li {
        padding-left: 1.25rem;
        position: relative;
        color: var(--muted);
        font-size: 1rem;
      }

      .list-clean li::before {
        content: "→";
        position: absolute;
        left: 0;
        color: var(--terra);
        font-size: 0.85rem;
      }

      .muted {
        color: var(--muted);
      }

      /* ── Hero panel ── */
      .hero-panel {
        position: relative;
        overflow: hidden;
        padding: 2rem;
        background: linear-gradient(145deg, rgba(236, 244, 232, 0.95), rgba(255, 253, 248, 0.9));
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
      }

      .brand-chip {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        border: 1px solid var(--line-strong);
        background: rgba(255, 253, 248, 0.95);
        color: var(--accent-deep);
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .brand-chip::before {
        content: "";
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: var(--accent);
        flex-shrink: 0;
      }

      .hero-support {
        margin-top: 1.5rem;
      }

      .micro-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
      }

      .micro-card {
        padding: 1rem;
        border-radius: var(--radius-sm);
        background: rgba(255, 253, 249, 0.85);
        border: 1px solid var(--line);
      }

      .micro-card strong {
        display: block;
        margin-bottom: 0.25rem;
        font-family: "Cormorant Garamond", serif;
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--accent-deep);
      }

      .micro-card p {
        font-size: 0.85rem;
        line-height: 1.5;
        max-width: none;
      }

      .accent-note {
        padding-left: 1rem;
        border-left: 3px solid var(--terra);
        color: var(--text);
        font-style: italic;
      }

      /* ── Trust bar ── */
      .trust-bar {
        background: var(--accent-deep);
        color: rgba(255, 253, 248, 0.85);
        padding: 0.65rem 0;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.03em;
        text-align: center;
      }

      .trust-bar-inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
      }

      .trust-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: rgba(255, 253, 248, 0.9);
      }

      .trust-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--terra);
        flex-shrink: 0;
      }

      /* ── Footer ── */
      .site-footer {
        background: var(--accent-deep);
        color: rgba(255, 253, 248, 0.8);
        padding: 4rem 0 2rem;
        margin-top: 4rem;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: 3rem;
        padding-bottom: 3rem;
        border-bottom: 1px solid rgba(255, 253, 248, 0.12);
      }

      .footer-brand p {
        color: rgba(255, 253, 248, 0.65);
        font-size: 0.95rem;
        max-width: 32ch;
        margin-top: 0.75rem;
        line-height: 1.65;
      }

      .footer-logo {
        height: 2.5rem;
        width: auto;
        margin-bottom: 0.75rem;
        filter: brightness(0) invert(1) opacity(0.85);
      }

      .footer-heading {
        font-family: "Cormorant Garamond", serif;
        font-size: 1.15rem;
        font-weight: 600;
        color: rgba(255, 253, 248, 0.95);
        margin-bottom: 1rem;
        letter-spacing: 0.01em;
      }

      .footer-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.6rem;
      }

      .footer-links a {
        color: rgba(255, 253, 248, 0.65);
        font-size: 0.95rem;
        transition: color 160ms ease;
      }

      .footer-links a:hover {
        color: rgba(255, 253, 248, 0.95);
      }

      .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.5rem;
        font-size: 0.85rem;
        color: rgba(255, 253, 248, 0.45);
        flex-wrap: wrap;
        gap: 1rem;
      }

      .footer-email a {
        color: rgba(255, 253, 248, 0.75);
        font-weight: 500;
        transition: color 160ms ease;
      }

      .footer-email a:hover {
        color: #fff;
      }

      /* ── Responsive ── */
      @media (max-width: 900px) {
        .hero-grid,
        .two-column,
        .feature-grid,
        .micro-grid,
        .bio-section {
          grid-template-columns: 1fr;
        }

        .bio-image-wrap {
          flex-direction: row;
          justify-content: flex-start;
        }

        .bio-image-placeholder {
          width: 80px;
          height: 80px;
          font-size: 2rem;
        }

        .resources-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }

        .site-header {
          position: sticky;
        }

        .nav-wrap {
          flex-wrap: wrap;
        }

        .section-head {
          flex-direction: column;
          align-items: flex-start;
        }

        h1 {
          max-width: 100%;
        }

        .hero,
        .page-hero {
          padding: 3.5rem 0 2rem;
        }
      }

      @media (max-width: 600px) {
        .resources-grid {
          grid-template-columns: 1fr;
        }

        .trust-bar-inner {
          gap: 1rem;
        }

        .footer-bottom {
          flex-direction: column;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div class="trust-bar">
      <div class="shell trust-bar-inner">
        <span class="trust-item"><span class="trust-dot"></span>Created by a classroom teacher</span>
        <span class="trust-item"><span class="trust-dot"></span>IB Primary PE specialist</span>
        <span class="trust-item"><span class="trust-dot"></span>Free resources — no sign-up required</span>
        <span class="trust-item"><span class="trust-dot"></span>New resources added regularly</span>
      </div>
    </div>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = site.description,
  currentPath = Astro.url.pathname
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #f7f3e8;
        --bg-soft: #eef2e6;
        --surface: rgba(253, 251, 245, 0.88);
        --surface-strong: rgba(255, 253, 249, 0.96);
        --surface-moss: rgba(239, 245, 235, 0.88);
        --line: rgba(90, 107, 85, 0.18);
        --line-strong: rgba(90, 107, 85, 0.28);
        --text: #243127;
        --muted: #5f6d61;
        --accent: #4c6b54;
        --accent-deep: #35513d;
        --accent-soft: #dce8d8;
        --earth: #8b7258;
        --shadow: 0 28px 70px rgba(63, 77, 56, 0.11);
        --shadow-soft: 0 18px 44px rgba(63, 77, 56, 0.08);
        --radius: 28px;
        --radius-sm: 16px;
        --shell: min(1120px, calc(100vw - 3rem));
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Manrope", sans-serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(194, 216, 187, 0.62), transparent 26%),
          radial-gradient(circle at top right, rgba(230, 220, 197, 0.45), transparent 24%),
          linear-gradient(180deg, #f7f4ea 0%, var(--bg) 40%, #edf2e6 100%);
        line-height: 1.65;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      main {
        display: block;
      }

      .shell {
        width: var(--shell);
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(18px);
        background: rgba(247, 243, 232, 0.78);
        border-bottom: 1px solid rgba(90, 107, 85, 0.12);
      }

      .nav-wrap,
      .footer-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
      }

      .nav-wrap {
        min-height: 5rem;
      }

      .brand {
        display: inline-flex;
        align-items: baseline;
        gap: 0.75rem;
      }

      .brand-mark {
        font-family: "Newsreader", serif;
        font-size: 1.8rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--accent-deep);
      }

      .brand-text,
      .eyebrow,
      .meta-text {
        color: var(--muted);
        font-size: 0.95rem;
      }

      .nav-list {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav-link {
        display: inline-flex;
        padding: 0.6rem 0.95rem;
        border-radius: 999px;
        color: var(--muted);
        transition:
          background-color 180ms ease,
          color 180ms ease,
          border-color 180ms ease;
        border: 1px solid transparent;
      }

      .nav-link:hover,
      .nav-link.active {
        background: rgba(220, 232, 216, 0.78);
        border-color: rgba(90, 107, 85, 0.12);
        color: var(--text);
      }

      .hero,
      .page-hero {
        padding: 5.5rem 0 2.5rem;
      }

      .hero-grid,
      .two-column {
        display: grid;
        grid-template-columns: 1.3fr 0.9fr;
        gap: 2rem;
        align-items: start;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--accent);
      }

      h1,
      h2,
      h3 {
        font-family: "Newsreader", serif;
        line-height: 1.05;
        margin: 0;
        font-weight: 500;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: clamp(3.2rem, 8vw, 6rem);
        max-width: 12ch;
        text-wrap: balance;
      }

      h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 1rem;
      }

      h3 {
        font-size: 1.6rem;
        margin-bottom: 0.6rem;
      }

      p {
        margin: 0;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .hero-copy p,
      .page-hero p {
        max-width: 62ch;
        font-size: 1.1rem;
      }

      .hero-copy {
        position: relative;
      }

      .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 2rem;
      }

      .button,
      .button-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.2rem;
        padding: 0.92rem 1.35rem;
        border-radius: 999px;
        border: 1px solid transparent;
        font-weight: 600;
        transition:
          transform 180ms ease,
          box-shadow 180ms ease,
          background-color 180ms ease,
          border-color 180ms ease;
      }

      .button {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
        color: #f8f7f1;
        box-shadow: 0 16px 34px rgba(53, 81, 61, 0.22);
      }

      .button-secondary {
        border-color: var(--line);
        background: rgba(255, 253, 249, 0.72);
        color: var(--text);
      }

      .button:hover,
      .button-secondary:hover {
        transform: translateY(-1px);
      }

      .button-secondary:hover {
        border-color: var(--line-strong);
        background: rgba(239, 245, 235, 0.84);
      }

      .panel,
      .feature-card,
      .resource-card,
      .blog-card,
      .quote-card {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.54), transparent 100%),
          var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow-soft);
      }

      .panel,
      .quote-card {
        padding: 1.8rem;
      }

      .feature-grid,
      .resources-grid,
      .blog-grid {
        display: grid;
        gap: 1.25rem;
      }

      .feature-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resources-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .blog-grid {
        grid-template-columns: 1fr;
      }

      .section {
        padding: 2.5rem 0 5rem;
      }

      .section-soft {
        position: relative;
      }

      .section-soft::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, rgba(239, 245, 235, 0.56), rgba(255, 255, 255, 0)),
          radial-gradient(circle at 12% 18%, rgba(200, 221, 193, 0.34), transparent 20%);
        pointer-events: none;
      }

      .section-soft > .shell {
        position: relative;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .feature-card,
      .blog-card,
      .resource-card {
        padding: 1.5rem;
      }

      .feature-card {
        background:
          linear-gradient(180deg, rgba(248, 252, 245, 0.92), rgba(255, 253, 249, 0.88));
      }

      .feature-card p,
      .blog-card p,
      .resource-card p,
      .quote-card p {
        font-size: 1rem;
      }

      .resource-meta,
      .blog-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 1rem;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .resource-meta span,
      .resource-category,
      .pill {
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        background: rgba(220, 232, 216, 0.9);
        color: var(--accent-deep);
      }

      .resource-image {
        width: 100%;
        border-radius: var(--radius-sm);
        margin-bottom: 1.25rem;
        object-fit: cover;
        aspect-ratio: 4 / 3;
      }

      .resource-tagline {
        color: var(--text);
        margin-bottom: 0.7rem;
      }

      .resource-footer,
      .card-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.25rem;
      }

      .resource-footer a,
      .card-link a {
        color: var(--accent);
        font-weight: 600;
      }

      .split-callout {
        padding: 2rem;
        background:
          linear-gradient(180deg, rgba(244, 248, 239, 0.84), rgba(255, 251, 245, 0.92));
      }

      .site-footer {
        padding: 2rem 0 3rem;
      }

      .footer-wrap {
        padding-top: 1.5rem;
        border-top: 1px solid rgba(90, 107, 85, 0.14);
        align-items: flex-start;
      }

      .stack {
        display: grid;
        gap: 1rem;
      }

      .list-clean {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      .muted {
        color: var(--muted);
      }

      .hero-panel {
        position: relative;
        overflow: hidden;
        padding: 2rem;
        background:
          radial-gradient(circle at top right, rgba(206, 223, 197, 0.6), transparent 30%),
          linear-gradient(180deg, rgba(251, 253, 248, 0.95), rgba(240, 246, 236, 0.9));
      }

      .hero-panel::after {
        content: "";
        position: absolute;
        width: 14rem;
        height: 14rem;
        right: -4rem;
        bottom: -5rem;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(158, 188, 150, 0.26), transparent 68%);
      }

      .brand-chip {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 0.8rem;
        border-radius: 999px;
        border: 1px solid rgba(90, 107, 85, 0.16);
        background: rgba(248, 251, 243, 0.92);
        color: var(--accent-deep);
        font-size: 0.92rem;
        font-weight: 600;
      }

      .brand-chip::before {
        content: "";
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #89a87d, #5f7f67);
        box-shadow: 0 0 0 0.25rem rgba(137, 168, 125, 0.12);
      }

      .hero-support {
        display: grid;
        gap: 1rem;
        margin-top: 1.5rem;
      }

      .micro-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
      }

      .micro-card {
        padding: 1rem;
        border-radius: 20px;
        background: rgba(255, 253, 249, 0.74);
        border: 1px solid rgba(90, 107, 85, 0.12);
      }

      .micro-card strong {
        display: block;
        margin-bottom: 0.3rem;
        font-family: "Newsreader", serif;
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--text);
      }

      .accent-note {
        padding-left: 1rem;
        border-left: 3px solid rgba(90, 107, 85, 0.28);
        color: var(--text);
      }

      @media (max-width: 900px) {
        .hero-grid,
        .two-column,
        .feature-grid,
        .resources-grid,
        .micro-grid {
          grid-template-columns: 1fr;
        }

        .site-header {
          position: static;
        }

        .nav-wrap,
        .footer-wrap,
        .section-head {
          align-items: flex-start;
          flex-direction: column;
        }

        h1 {
          max-width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

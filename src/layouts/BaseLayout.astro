---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = site.description,
  currentPath = Astro.url.pathname
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />

    <!-- Canonical & indexing -->
    <link rel="canonical" href={`https://theseedlab.org${currentPath}`} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph (social sharing) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The SEED Lab" />
    <meta property="og:title" content={`${title} | The SEED Lab`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://theseedlab.org${currentPath}`} />
    <meta property="og:image" content="https://theseedlab.org/seed-logo.png" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | The SEED Lab`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://theseedlab.org/seed-logo.png" />

    <!-- Authorship & theme -->
    <meta name="author" content="The SEED Lab" />
    <meta name="theme-color" content="#14213D" />

    <!-- Google Analytics — replace G-XXXXXXXXXX with your Measurement ID -->
    <!-- To get your ID: analytics.google.com → Admin → Data Streams → your stream -->
    <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script> -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;1,9..144,300;1,9..144,600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* ── Galaxy Greenhouse colour tokens ── */

        /* Deep space backgrounds */
        --space-black: #070A12;
        --deep-navy: #0E1628;
        --midnight-blue: #14213D;
        --soft-charcoal: #1E2636;

        /* Warm reading backgrounds */
        --bg: #F8F4E8;
        --bg-soft: #F3E8D0;
        --warm-sand: #D8B87A;
        --bronze: #A9783A;

        /* Surfaces (light sections) */
        --surface: rgba(248, 244, 232, 0.96);
        --surface-strong: rgba(255, 252, 245, 0.99);
        --surface-dark: rgba(14, 22, 40, 0.92);

        /* Borders */
        --line: rgba(169, 120, 58, 0.18);
        --line-strong: rgba(169, 120, 58, 0.32);
        --line-cosmic: rgba(125, 211, 252, 0.15);

        /* Text */
        --text: #1A1A2E;
        --muted: #5A5A72;
        --text-on-dark: #F3E8D0;
        --muted-on-dark: rgba(243, 232, 208, 0.65);

        /* Seed green */
        --seed-green: #7FB069;
        --growth-green: #A7C788;
        --accent: #7FB069;
        --accent-deep: #5A8A45;
        --accent-soft: rgba(127, 176, 105, 0.15);

        /* Warm gold — primary CTA */
        --lantern-gold: #F2C766;
        --lantern-gold-deep: #C9962A;
        --terra: #F2C766;
        --terra-deep: #C9962A;
        --terra-soft: rgba(242, 199, 102, 0.12);

        /* Cosmic accents — used sparingly */
        --jedi-blue: #7DD3FC;
        --nebula-violet: #8B7CF6;
        --starlight: #F8F4E8;

        /* Glow utilities */
        --glow-gold: 0 0 32px rgba(242, 199, 102, 0.25);
        --glow-blue: 0 0 32px rgba(125, 211, 252, 0.20);
        --glow-green: 0 0 32px rgba(127, 176, 105, 0.25);

        /* Shadows */
        --shadow: 0 24px 60px rgba(7, 10, 18, 0.18);
        --shadow-soft: 0 8px 32px rgba(7, 10, 18, 0.10);
        --shadow-hover: 0 16px 48px rgba(7, 10, 18, 0.22);
        --shadow-card: 0 4px 24px rgba(169, 120, 58, 0.10);

        /* Shape */
        --radius: 16px;
        --radius-sm: 10px;
        --radius-lg: 24px;
        --shell: min(1120px, calc(100vw - 3rem));
      }

      /* ── Reduced motion ── */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
        html { scroll-behavior: auto; }
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Atkinson Hyperlegible", "Space Grotesk", sans-serif;
        font-size: 1.05rem;
        color: var(--text);
        background: var(--bg);
        line-height: 1.75;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      main {
        display: block;
      }

      /* ── Layout ── */
      .shell {
        width: var(--shell);
        margin: 0 auto;
      }

      /* ── Header ── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(20px);
        background: rgba(20, 33, 61, 0.92);
        border-bottom: 1px solid var(--line-cosmic);
        transition: box-shadow 200ms ease;
      }

      .site-header.scrolled {
        box-shadow: 0 2px 20px rgba(7, 10, 18, 0.4);
      }

      .nav-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 5rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        text-decoration: none;
        flex-shrink: 0;
      }

      .brand-mark {
        font-family: "Space Grotesk", sans-serif;
        font-size: 1.55rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--starlight);
        line-height: 1.1;
      }

      .brand-text,
      .meta-text {
        color: var(--muted-on-dark);
        font-size: 0.9rem;
      }

      .nav-list {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav-link {
        display: inline-flex;
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        color: rgba(243, 232, 208, 0.75);
        font-size: 0.92rem;
        font-weight: 500;
        transition:
          background-color 160ms ease,
          color 160ms ease;
        border: 1px solid transparent;
        font-family: "Space Grotesk", sans-serif;
      }

      .nav-link:hover,
      .nav-link.active {
        background: rgba(127, 176, 105, 0.15);
        color: var(--growth-green);
      }

      .nav-cta {
        display: inline-flex;
        padding: 0.55rem 1.1rem;
        border-radius: 999px;
        background: var(--lantern-gold);
        color: var(--midnight-blue) !important;
        font-size: 0.92rem;
        font-weight: 700;
        font-family: "Space Grotesk", sans-serif;
        transition: background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
        margin-left: 0.5rem;
      }

      .nav-cta:hover {
        background: #fff0b3;
        transform: translateY(-1px);
        box-shadow: var(--glow-gold);
      }

      /* ── Typography ── */
      .eyebrow {
        display: inline-block;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.75rem;
        font-weight: 700;
        font-family: "Space Grotesk", sans-serif;
        color: var(--lantern-gold);
      }

      h1, h2, h3, h4 {
        font-family: "Fraunces", serif;
        line-height: 1.08;
        margin: 0;
        font-weight: 600;
        color: var(--text);
        letter-spacing: -0.01em;
      }

      h1 {
        font-size: clamp(2.8rem, 6vw, 5rem);
        max-width: 16ch;
        text-wrap: balance;
        line-height: 1.04;
      }

      h2 {
        font-size: clamp(1.9rem, 3.5vw, 2.75rem);
        margin-bottom: 0.75rem;
        line-height: 1.1;
      }

      h3 {
        font-size: 1.45rem;
        margin-bottom: 0.5rem;
        line-height: 1.2;
      }

      p {
        margin: 0;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 68ch;
      }

      strong {
        color: var(--text);
        font-weight: 700;
      }

      /* ── Cosmic section utility ── */
      .cosmic {
        background: var(--midnight-blue);
        color: var(--text-on-dark);
      }

      .cosmic h1, .cosmic h2, .cosmic h3, .cosmic h4 {
        color: var(--starlight);
      }

      .cosmic p {
        color: var(--muted-on-dark);
      }

      .cosmic .eyebrow {
        color: var(--lantern-gold);
      }

      /* ── Focus styles ── */
      :focus-visible {
        outline: 2px solid var(--jedi-blue);
        outline-offset: 3px;
        border-radius: 4px;
      }

      /* ── Hero ── */
      .hero,
      .page-hero {
        padding: 6rem 0 3.5rem;
      }

      .hero-grid,
      .two-column {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 3rem;
        align-items: start;
      }

      .hero-copy {
        position: relative;
      }

      .hero-copy p,
      .page-hero p {
        font-size: 1.15rem;
        max-width: 58ch;
      }

      .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 2.5rem;
      }

      /* ── Buttons ── */
      .button,
      .button-secondary,
      .button-terra {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3rem;
        padding: 0.8rem 1.6rem;
        border-radius: 999px;
        border: 1.5px solid transparent;
        font-family: "Space Grotesk", sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition:
          transform 160ms ease,
          box-shadow 160ms ease,
          background-color 160ms ease,
          border-color 160ms ease;
      }

      .button {
        background: var(--seed-green);
        color: #fff;
        box-shadow: 0 8px 24px rgba(127, 176, 105, 0.30);
      }

      .button:hover {
        background: var(--accent-deep);
        transform: translateY(-2px);
        box-shadow: var(--glow-green);
      }

      .button-terra {
        background: var(--lantern-gold);
        color: var(--midnight-blue);
        font-weight: 700;
        box-shadow: 0 8px 24px rgba(242, 199, 102, 0.28);
      }

      .button-terra:hover {
        background: #fff0b3;
        transform: translateY(-2px);
        box-shadow: var(--glow-gold);
      }

      /* ── Bio section ── */
      .bio-section {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 3rem;
        align-items: start;
      }

      .bio-image-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
      }

      .bio-photo {
        width: 200px;
        height: 200px;
        border-radius: var(--radius);
        object-fit: cover;
        border: 3px solid var(--line-strong);
        box-shadow: var(--shadow-soft);
      }

      .bio-location {
        font-size: 0.85rem;
        color: var(--muted);
        font-weight: 500;
      }

      .bio-content { }

      .bio-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
      }

      .button-secondary {
        border-color: var(--line-strong);
        background: transparent;
        color: var(--text);
      }

      .button-secondary:hover {
        border-color: var(--seed-green);
        background: var(--accent-soft);
        color: var(--accent-deep);
        transform: translateY(-1px);
      }

      /* Ghost button for dark/cosmic sections */
      .button-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3rem;
        padding: 0.8rem 1.6rem;
        border-radius: 999px;
        border: 1.5px solid rgba(243, 232, 208, 0.35);
        background: transparent;
        color: var(--text-on-dark);
        font-family: "Space Grotesk", sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
      }

      .button-ghost:hover {
        border-color: var(--lantern-gold);
        background: rgba(242, 199, 102, 0.08);
        transform: translateY(-1px);
      }

      /* ── Cards ── */
      .panel,
      .feature-card,
      .resource-card,
      .blog-card,
      .quote-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow-card);
        transition: box-shadow 200ms ease, transform 200ms ease, border-color 200ms ease;
      }

      .resource-card:hover,
      .blog-card:hover {
        box-shadow: var(--shadow-hover);
        transform: translateY(-3px);
        border-color: var(--warm-sand);
      }

      .panel,
      .quote-card {
        padding: 2rem;
      }

      .feature-card,
      .blog-card,
      .resource-card {
        padding: 1.5rem;
      }

      .feature-card p,
      .blog-card p,
      .resource-card p,
      .quote-card p {
        font-size: 0.98rem;
      }

      /* ── Grids ── */
      .feature-grid,
      .resources-grid,
      .blog-grid {
        display: grid;
        gap: 1.5rem;
      }

      .feature-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resources-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .blog-grid {
        grid-template-columns: 1fr;
      }

      /* ── Sections — planet surface + galaxy nebula treatment ── */
      .section {
        position: relative;
        padding: 4rem 0 6rem;
        background:
          radial-gradient(ellipse 55% 35% at 90% 10%, rgba(200,158,60,0.07) 0%, transparent 65%),
          radial-gradient(ellipse 35% 25% at 10% 90%, rgba(160,120,50,0.05) 0%, transparent 60%),
          var(--bg);
      }

      .section-soft {
        position: relative;
        padding: 4rem 0 6rem;
        background:
          radial-gradient(ellipse 50% 40% at 5% 95%, rgba(80,140,80,0.08) 0%, transparent 65%),
          radial-gradient(ellipse 35% 30% at 95% 5%, rgba(100,160,100,0.05) 0%, transparent 60%),
          var(--bg-soft);
      }

      /* Dark cosmic section — nebula galaxy */
      .section-cosmic {
        position: relative;
        padding: 5rem 0 6rem;
        overflow: hidden;
        background:
          radial-gradient(ellipse 55% 65% at 90% 10%, rgba(90,30,140,0.38) 0%, transparent 60%),
          radial-gradient(ellipse 40% 30% at 10% 90%, rgba(20,80,130,0.26) 0%, transparent 55%),
          var(--midnight-blue);
      }

      .section-deep {
        position: relative;
        padding: 5rem 0 6rem;
        overflow: hidden;
        background:
          radial-gradient(ellipse 50% 55% at 15% 80%, rgba(20,110,130,0.35) 0%, transparent 60%),
          radial-gradient(ellipse 35% 30% at 85% 15%, rgba(70,20,110,0.22) 0%, transparent 55%),
          var(--deep-navy);
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 2.5rem;
      }

      /* ── Resource cards ── */
      .resource-image {
        width: 100%;
        border-radius: var(--radius-sm);
        margin-bottom: 1.25rem;
        object-fit: cover;
        aspect-ratio: 4 / 3;
      }

      .resource-meta,
      .blog-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        font-size: 0.82rem;
      }

      .resource-meta span,
      .resource-category,
      .pill {
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-deep);
        font-weight: 700;
        font-size: 0.78rem;
        font-family: "Space Grotesk", sans-serif;
        letter-spacing: 0.02em;
      }

      .resource-tagline {
        color: var(--text);
        font-weight: 500;
        margin-bottom: 0.5rem;
        font-size: 0.98rem;
      }

      .resource-footer,
      .card-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
      }

      .resource-footer a,
      .card-link a {
        color: var(--accent-deep);
        font-weight: 700;
        font-size: 0.92rem;
        font-family: "Space Grotesk", sans-serif;
        transition: color 160ms ease;
      }

      .resource-footer a:hover,
      .card-link a:hover {
        color: var(--lantern-gold-deep);
      }

      /* ── Misc components ── */
      .split-callout {
        padding: 2rem;
        background: linear-gradient(135deg, rgba(127, 176, 105, 0.08), rgba(248, 244, 232, 0.95));
      }

      .stack {
        display: grid;
        gap: 1rem;
      }

      .list-clean {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.75rem;
      }

      .list-clean li {
        padding-left: 1.25rem;
        position: relative;
        color: var(--muted);
        font-size: 1rem;
      }

      .list-clean li::before {
        content: "→";
        position: absolute;
        left: 0;
        color: var(--lantern-gold-deep);
        font-size: 0.85rem;
      }

      .muted {
        color: var(--muted);
      }

      /* ── Hero panel ── */
      .hero-panel {
        position: relative;
        overflow: hidden;
        padding: 2rem;
        background: linear-gradient(145deg, rgba(14, 22, 40, 0.92), rgba(20, 33, 61, 0.85));
        border: 1px solid var(--line-cosmic);
        border-radius: var(--radius-lg);
        box-shadow: var(--glow-blue);
      }

      .brand-chip {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        border: 1px solid rgba(125, 211, 252, 0.25);
        background: rgba(20, 33, 61, 0.8);
        color: var(--jedi-blue);
        font-size: 0.78rem;
        font-weight: 700;
        font-family: "Space Grotesk", sans-serif;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .brand-chip::before {
        content: "";
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--seed-green);
        flex-shrink: 0;
        box-shadow: 0 0 6px var(--seed-green);
      }

      .hero-support {
        margin-top: 1.5rem;
      }

      .micro-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
      }

      .micro-card {
        padding: 1rem;
        border-radius: var(--radius-sm);
        background: rgba(14, 22, 40, 0.6);
        border: 1px solid var(--line-cosmic);
      }

      .micro-card strong {
        display: block;
        margin-bottom: 0.25rem;
        font-family: "Space Grotesk", sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--growth-green);
      }

      .micro-card p {
        font-size: 0.85rem;
        line-height: 1.5;
        max-width: none;
      }

      .accent-note {
        padding-left: 1rem;
        border-left: 3px solid var(--lantern-gold);
        color: var(--text);
        font-style: italic;
      }

      /* ── Trust bar ── */
      .trust-bar {
        background: var(--space-black);
        color: rgba(243, 232, 208, 0.75);
        padding: 0.6rem 0;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-align: center;
        font-family: "Space Grotesk", sans-serif;
        border-bottom: 1px solid rgba(125, 211, 252, 0.08);
      }

      .trust-bar-inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
      }

      .trust-item {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: rgba(243, 232, 208, 0.8);
      }

      .trust-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--seed-green);
        flex-shrink: 0;
        box-shadow: 0 0 4px var(--seed-green);
      }

      /* ── Footer ── */
      .site-footer {
        background: var(--deep-navy);
        color: var(--muted-on-dark);
        padding: 4rem 0 2rem;
        margin-top: 4rem;
        border-top: 1px solid var(--line-cosmic);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: 3rem;
        padding-bottom: 3rem;
        border-bottom: 1px solid rgba(125, 211, 252, 0.08);
      }

      .footer-brand p {
        color: var(--muted-on-dark);
        font-size: 0.95rem;
        max-width: 32ch;
        margin-top: 0.75rem;
        line-height: 1.7;
      }

      .footer-logo {
        height: 2.5rem;
        width: auto;
        margin-bottom: 0.75rem;
        filter: brightness(0) invert(1) opacity(0.85);
      }

      .footer-heading {
        font-family: "Space Grotesk", sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--lantern-gold);
        margin-bottom: 1rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .footer-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.6rem;
      }

      .footer-links a {
        color: var(--muted-on-dark);
        font-size: 0.95rem;
        transition: color 160ms ease;
      }

      .footer-links a:hover {
        color: var(--text-on-dark);
      }

      .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.5rem;
        font-size: 0.85rem;
        color: rgba(243, 232, 208, 0.35);
        flex-wrap: wrap;
        gap: 1rem;
        font-family: "Space Grotesk", sans-serif;
      }

      .footer-email a {
        color: var(--growth-green);
        font-weight: 500;
        transition: color 160ms ease;
      }

      .footer-email a:hover {
        color: var(--seed-green);
      }

      /* ── Responsive ── */
      @media (max-width: 900px) {
        .hero-grid,
        .two-column,
        .feature-grid,
        .micro-grid,
        .bio-section {
          grid-template-columns: 1fr;
        }

        .bio-image-wrap {
          flex-direction: row;
          justify-content: flex-start;
        }

        .bio-photo {
          width: 80px;
          height: 80px;
        }

        .resources-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }

        .site-header {
          position: sticky;
        }

        .nav-wrap {
          flex-wrap: wrap;
        }

        .section-head {
          flex-direction: column;
          align-items: flex-start;
        }

        h1 {
          max-width: 100%;
        }

        .hero,
        .page-hero {
          padding: 3.5rem 0 2rem;
        }
      }

      @media (max-width: 600px) {
        .resources-grid {
          grid-template-columns: 1fr;
        }

        .trust-bar-inner {
          gap: 1rem;
        }

        .footer-bottom {
          flex-direction: column;
          text-align: center;
        }
      }

      /* ══════════════════════════════════════════
         PHASE 11 — Accessibility Fixes
         ══════════════════════════════════════════ */

      /* ── Skip-to-content link ── */
      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        z-index: 9999;
        padding: 0.6rem 1.2rem;
        background: var(--lantern-gold);
        color: var(--space-black);
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 0 0 var(--radius-sm) var(--radius-sm);
        text-decoration: none;
        transition: top 160ms ease;
      }

      .skip-link:focus {
        top: 0;
      }

      /* ── Eyebrow contrast fix on light/parchment sections ──
         --lantern-gold (#F2C766) on parchment (#F8F4E8) = 2.42:1 — fails WCAG AA.
         On light sections override to accent-deep (#4A6B54) = 5.42:1 ✅
      */
      .section .eyebrow,
      .section-soft .eyebrow,
      .page-hero .eyebrow,
      .about-hero .eyebrow,
      .post-hero .eyebrow {
        color: var(--accent-deep);
      }

      /* Keep gold for explicitly dark/cosmic contexts */
      .section-cosmic .eyebrow,
      .section-deep .eyebrow,
      .cosmic .eyebrow,
      .hero-cosmic .eyebrow,
      .fn-hero .eyebrow,
      .sh-hero .eyebrow,
      .res-hero .eyebrow,
      .cls-hero .eyebrow,
      .lw-hero .eyebrow,
      .panel-dark .eyebrow {
        color: var(--lantern-gold) !important;
      }

      /* ══════════════════════════════════════════
         PHASE 10 — Animation & Interaction Polish
         ══════════════════════════════════════════ */

      /* ── Trust pip pulse ── */
      @keyframes pip-pulse {
        0%, 100% {
          box-shadow: 0 0 4px var(--seed-green);
          transform: scale(1);
        }
        50% {
          box-shadow: 0 0 10px var(--seed-green), 0 0 22px rgba(127,176,105,0.25);
          transform: scale(1.35);
        }
      }

      .trust-dot {
        animation: pip-pulse 3.5s ease-in-out infinite;
      }

      .trust-item:nth-child(2) .trust-dot { animation-delay: 0.85s; }
      .trust-item:nth-child(3) .trust-dot { animation-delay: 1.7s; }
      .trust-item:nth-child(4) .trust-dot { animation-delay: 2.55s; }

      /* ── Brand hover nudge ── */
      .brand {
        transition: transform 220ms ease, opacity 220ms ease;
      }
      .brand:hover {
        transform: scale(1.025);
        opacity: 0.95;
      }

      /* ── Nav link — soft glow on hover/active ── */
      .nav-link {
        transition:
          background-color 180ms ease,
          color 180ms ease,
          box-shadow 180ms ease;
      }
      .nav-link:hover {
        box-shadow: 0 0 0 1.5px rgba(127,176,105,0.2), inset 0 0 14px rgba(127,176,105,0.06);
      }
      .nav-link.active {
        box-shadow: 0 0 0 1.5px rgba(127,176,105,0.25), inset 0 0 16px rgba(127,176,105,0.08);
      }

      /* ── Nav CTA — gold glow bloom ── */
      .nav-cta:hover {
        box-shadow: 0 0 24px rgba(242,199,102,0.45), 0 4px 12px rgba(242,199,102,0.2);
      }

      /* ── Button active (tactile press) ── */
      .button:active,
      .button-terra:active,
      .button-ghost:active,
      .button-secondary:active {
        transform: translateY(0) scale(0.97);
        transition-duration: 60ms;
      }

      /* ── Scroll fade-up ── */
      .fade-up {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 550ms ease, transform 550ms ease;
        will-change: opacity, transform;
      }

      .fade-up.in-view {
        opacity: 1;
        transform: translateY(0);
      }

      /* Stagger siblings */
      .fade-up.in-view:nth-child(2) { transition-delay: 80ms; }
      .fade-up.in-view:nth-child(3) { transition-delay: 160ms; }
      .fade-up.in-view:nth-child(4) { transition-delay: 240ms; }
      .fade-up.in-view:nth-child(5) { transition-delay: 320ms; }
      .fade-up.in-view:nth-child(6) { transition-delay: 400ms; }

      /* ── Hero entrance ── */
      @keyframes hero-rise {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .anim-rise {
        animation: hero-rise 650ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
      }

      .anim-d1 { animation-delay: 80ms; }
      .anim-d2 { animation-delay: 220ms; }
      .anim-d3 { animation-delay: 360ms; }
      .anim-d4 { animation-delay: 480ms; }
      .anim-d5 { animation-delay: 580ms; }
      .anim-d6 { animation-delay: 680ms; }

      /* ── Pathway card glow (homepage) ── */
      .pathway-card {
        transition:
          transform 240ms ease,
          box-shadow 240ms ease,
          border-color 240ms ease;
      }

      .pathway-card.glow-blue:hover {
        box-shadow: 0 8px 40px rgba(125,211,252,0.22), 0 0 0 1.5px rgba(125,211,252,0.3);
      }

      .pathway-card.glow-gold:hover {
        box-shadow: 0 8px 40px rgba(242,199,102,0.22), 0 0 0 1.5px rgba(242,199,102,0.3);
      }

      .pathway-card.glow-green:hover {
        box-shadow: 0 8px 40px rgba(127,176,105,0.22), 0 0 0 1.5px rgba(127,176,105,0.3);
      }

      /* ── prefers-reduced-motion — comprehensive fallback ── */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          transition-delay: 0ms !important;
        }

        .fade-up {
          opacity: 1;
          transform: none;
        }

        .anim-rise {
          animation: none;
          opacity: 1;
          transform: none;
        }

        .trust-dot {
          animation: none;
        }

        .stars-2,
        .stars-3 {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <!-- Skip to main content — keyboard / screen reader accessibility -->
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="trust-bar">
      <div class="shell trust-bar-inner">
        <span class="trust-item"><span class="trust-dot"></span>Created by a classroom teacher</span>
        <span class="trust-item"><span class="trust-dot"></span>IB Primary PE specialist</span>
        <span class="trust-item"><span class="trust-dot"></span>Free resources — no sign-up required</span>
        <span class="trust-item"><span class="trust-dot"></span>New resources added regularly</span>
      </div>
    </div>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      /* ── Scroll fade-up observer ── */
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const TARGETS = [
          '.resource-card',
          '.fn-card',
          '.rcard',
          '.panel',
          '.feature-card',
          '.blog-card',
          '.section-head',
        ].join(', ');

        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
        );

        document.querySelectorAll<HTMLElement>(TARGETS).forEach((el) => {
          const rect = el.getBoundingClientRect();
          // Elements already fully above the fold skip the animation
          if (rect.bottom < 0 || rect.top > window.innerHeight * 0.85) {
            el.classList.add('fade-up');
            obs.observe(el);
          } else {
            // In initial viewport — show immediately, no flicker
            el.classList.add('fade-up', 'in-view');
          }
        });
      })();
    </script>
  </body>
</html>
